SQL> DECLARE
  2    v_origem NUMBER;
  3    v_backup NUMBER;
  4  BEGIN
  5    SELECT COUNT(*) INTO v_origem FROM TSICFG;
  6    INSERT INTO BKP_RMD_TSICFG
  7    SELECT :RMD_ID_TSICFG, SYSTIMESTAMP,
  8           SYS_CONTEXT('USERENV','SESSION_USER'), T.*
  9      FROM TSICFG T;
 10    v_backup := SQL%ROWCOUNT;
 11    IF v_backup <> v_origem THEN
 12      RAISE_APPLICATION_ERROR(-20101,
 13        'Snapshot TSICFG divergente: origem='||v_origem||', backup='||v_backup);
 14    END IF;
 15    DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||:RMD_ID_TSICFG);
 16    DBMS_OUTPUT.PUT_LINE('TSICFG_BACKUP='||v_backup);
 17  END;
