SQL> DECLARE
  2    v_ref NUMBER;
  3    v_del NUMBER;
  4    v_upd NUMBER;
  5    v_ins NUMBER;
  6    v_final NUMBER;
  7    v_div NUMBER;
  8  BEGIN
  9    SELECT COUNT(*) INTO v_ref FROM RMD_REF_TSICFG_MODELO;
 10    IF v_ref <> 994 THEN
 11      RAISE_APPLICATION_ERROR(-20102,
 12        'Referencia Modelo divergente: esperado=994, obtido='||v_ref);
 13    END IF;
 14  
 15    DELETE FROM TSICFG E
 16     WHERE NOT EXISTS (
 17       SELECT 1 FROM RMD_REF_TSICFG_MODELO R
 18        WHERE R.CHAVE=E.CHAVE AND R.CODUSU=E.CODUSU AND R.TIPO=E.TIPO
 19          AND NVL(R.CHAVEPAI,CHR(0))=NVL(E.CHAVEPAI,CHR(0)));
 20    v_del:=SQL%ROWCOUNT;
 21  
 22    UPDATE TSICFG E
 23       SET E.CONFIG=(
 24         SELECT R.CONFIG FROM RMD_REF_TSICFG_MODELO R
 25          WHERE R.CHAVE=E.CHAVE AND R.CODUSU=E.CODUSU AND R.TIPO=E.TIPO
 26            AND NVL(R.CHAVEPAI,CHR(0))=NVL(E.CHAVEPAI,CHR(0)))
 27     WHERE EXISTS (
 28       SELECT 1 FROM RMD_REF_TSICFG_MODELO R
 29        WHERE R.CHAVE=E.CHAVE AND R.CODUSU=E.CODUSU AND R.TIPO=E.TIPO
 30          AND NVL(R.CHAVEPAI,CHR(0))=NVL(E.CHAVEPAI,CHR(0))
 31          AND ((E.CONFIG IS NULL AND R.CONFIG IS NOT NULL)
 32            OR (E.CONFIG IS NOT NULL AND R.CONFIG IS NULL)
 33            OR (E.CONFIG IS NOT NULL AND R.CONFIG IS NOT NULL
 34                AND DBMS_LOB.COMPARE(E.CONFIG,R.CONFIG)<>0)));
 35    v_upd:=SQL%ROWCOUNT;
 36  
 37    INSERT INTO TSICFG (CHAVE,CODUSU,TIPO,CONFIG,CHAVEPAI)
 38    SELECT R.CHAVE,R.CODUSU,R.TIPO,R.CONFIG,R.CHAVEPAI
 39      FROM RMD_REF_TSICFG_MODELO R
 40     WHERE NOT EXISTS (
 41       SELECT 1 FROM TSICFG E
 42        WHERE E.CHAVE=R.CHAVE AND E.CODUSU=R.CODUSU AND E.TIPO=R.TIPO
 43          AND NVL(E.CHAVEPAI,CHR(0))=NVL(R.CHAVEPAI,CHR(0)));
 44    v_ins:=SQL%ROWCOUNT;
 45  
 46    SELECT COUNT(*) INTO v_final FROM TSICFG;
 47    SELECT COUNT(*) INTO v_div
 48      FROM TSICFG E
 49     WHERE NOT EXISTS (
 50       SELECT 1 FROM RMD_REF_TSICFG_MODELO R
 51        WHERE R.CHAVE=E.CHAVE AND R.CODUSU=E.CODUSU AND R.TIPO=E.TIPO
 52          AND NVL(R.CHAVEPAI,CHR(0))=NVL(E.CHAVEPAI,CHR(0))
 53          AND ((E.CONFIG IS NULL AND R.CONFIG IS NULL)
 54            OR (E.CONFIG IS NOT NULL AND R.CONFIG IS NOT NULL
 55                AND DBMS_LOB.COMPARE(E.CONFIG,R.CONFIG)=0)));
 56    IF v_final<>v_ref OR v_div<>0 THEN
 57      RAISE_APPLICATION_ERROR(-20103,
 58        'Resultado TSICFG divergente: final='||v_final||', referencia='||v_ref||', divergencias='||v_div);
 59    END IF;
 60  
 61    COMMIT;
 62    DBMS_OUTPUT.PUT_LINE('TSICFG_EXCLUIDAS='||v_del);
 63    DBMS_OUTPUT.PUT_LINE('TSICFG_ATUALIZADAS='||v_upd);
 64    DBMS_OUTPUT.PUT_LINE('TSICFG_INSERIDAS='||v_ins);
 65    DBMS_OUTPUT.PUT_LINE('TSICFG_FINAL='||v_final);
 66  END;
 67  /
