SQL> PROMPT === REFERENCIAS FISICAS REMANESCENTES ===
=== REFERENCIAS FISICAS REMANESCENTES ===
SQL> DECLARE
  2    v_owner VARCHAR2(128):=SYS_CONTEXT('USERENV','CURRENT_SCHEMA');
  3    v_id VARCHAR2(40):='RMD_ALH_2930_20260916161842236';
  4    v_sql VARCHAR2(32767);
  5    v_n NUMBER;
  6    v_refs NUMBER:=0;
  7    v_erros NUMBER:=0;
  8  BEGIN
  9    FOR r IN (
 10      SELECT DISTINCT C.TABLE_NAME,C.COLUMN_NAME
 11        FROM ALL_TAB_COLUMNS C
 12        JOIN ALL_TABLES T ON T.OWNER=C.OWNER AND T.TABLE_NAME=C.TABLE_NAME
 13       WHERE C.OWNER=v_owner
 14         AND C.COLUMN_NAME IN ('CODBAI','CODEND')
 15         AND C.TABLE_NAME NOT IN ('TSIBAI','TSIEND')
 16         AND C.TABLE_NAME NOT LIKE 'BKP_RMD%'
 17         AND C.TABLE_NAME NOT LIKE 'RMD_ALH_2930%'
 18    ) LOOP
 19      BEGIN
 20        IF r.COLUMN_NAME='CODBAI' THEN
 21          v_sql:='SELECT COUNT(*) FROM '||r.TABLE_NAME||' T WHERE EXISTS (SELECT 1 FROM RMD_ALH_2930_MAP M WHERE M.ID_EXECUCAO=:1 AND M.TIPO=''BAI'' AND M.COD_OBSOLETO=T.CODBAI)';
 22        ELSE
 23          v_sql:='SELECT COUNT(*) FROM '||r.TABLE_NAME||' T WHERE EXISTS (SELECT 1 FROM RMD_ALH_2930_MAP M WHERE M.ID_EXECUCAO=:1 AND M.TIPO=''END'' AND M.COD_OBSOLETO=T.CODEND)';
 24        END IF;
 25        EXECUTE IMMEDIATE v_sql INTO v_n USING v_id;
 26        v_refs:=v_refs+v_n;
 27      EXCEPTION WHEN OTHERS THEN
 28        v_erros:=v_erros+1;
 29        DBMS_OUTPUT.PUT_LINE('ERRO_VALIDACAO_RAMO|'||r.TABLE_NAME||'|'||r.COLUMN_NAME||'|'||SQLERRM);
 30      END;
 31    END LOOP;
 32  
 33    FOR r IN (
 34      SELECT DISTINCT C.TABLE_NAME,CC.COLUMN_NAME,P.TABLE_NAME PAI
 35        FROM ALL_CONSTRAINTS C
 36        JOIN ALL_CONS_COLUMNS CC
 37          ON CC.OWNER=C.OWNER AND CC.CONSTRAINT_NAME=C.CONSTRAINT_NAME
 38         AND CC.POSITION IS NOT NULL
 39        JOIN ALL_CONSTRAINTS P
 40          ON P.OWNER=C.R_OWNER AND P.CONSTRAINT_NAME=C.R_CONSTRAINT_NAME
 41        JOIN ALL_CONS_COLUMNS PC
 42          ON PC.OWNER=P.OWNER AND PC.CONSTRAINT_NAME=P.CONSTRAINT_NAME
 43         AND PC.POSITION=CC.POSITION
 44       WHERE C.OWNER=v_owner AND C.CONSTRAINT_TYPE='R'
 45         AND P.OWNER=v_owner AND P.TABLE_NAME IN ('TSIBAI','TSIEND')
 46         AND PC.COLUMN_NAME IN ('CODBAI','CODEND')
 47         AND CC.COLUMN_NAME NOT IN ('CODBAI','CODEND')
 48         AND C.TABLE_NAME NOT IN ('TSIBAI','TSIEND')
 49         AND C.TABLE_NAME NOT LIKE 'BKP_RMD%'
 50         AND C.TABLE_NAME NOT LIKE 'RMD_ALH_2930%'
 51    ) LOOP
 52      BEGIN
 53        IF r.PAI='TSIBAI' THEN
 54          v_sql:='SELECT COUNT(*) FROM '||r.TABLE_NAME||' T WHERE EXISTS (SELECT 1 FROM RMD_ALH_2930_MAP M WHERE M.ID_EXECUCAO=:1 AND M.TIPO=''BAI'' AND M.COD_OBSOLETO=T.'||r.COLUMN_NAME||')';
 55        ELSE
 56          v_sql:='SELECT COUNT(*) FROM '||r.TABLE_NAME||' T WHERE EXISTS (SELECT 1 FROM RMD_ALH_2930_MAP M WHERE M.ID_EXECUCAO=:1 AND M.TIPO=''END'' AND M.COD_OBSOLETO=T.'||r.COLUMN_NAME||')';
 57        END IF;
 58        EXECUTE IMMEDIATE v_sql INTO v_n USING v_id;
 59        v_refs:=v_refs+v_n;
 60      EXCEPTION WHEN OTHERS THEN
 61        v_erros:=v_erros+1;
 62        DBMS_OUTPUT.PUT_LINE('ERRO_VALIDACAO_FK|'||r.TABLE_NAME||'|'||r.COLUMN_NAME||'|'||SQLERRM);
 63      END;
 64    END LOOP;
 65    DBMS_OUTPUT.PUT_LINE('REFERENCIAS_REMANESCENTES_FINAL='||v_refs||'; ERROS_VALIDACAO='||v_erros);
 66  END;
 67  /
REFERENCIAS_REMANESCENTES_FINAL=0; ERROS_VALIDACAO=0


