ID_EXECUCAO_MAPA=RMD_FDUP_ALH_2026091701
SQL> 
SQL> DECLARE
  2    v_exists NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO v_exists
  5      FROM ALL_TABLES
  6     WHERE OWNER = SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
  7       AND TABLE_NAME = 'BKP_RMD_ALH_DUP_PPG_20260917';
  8    IF v_exists > 0 THEN
  9      RAISE_APPLICATION_ERROR(-20322,
 10        'BKP_RMD_ALH_DUP_PPG_20260917 ja existe; nao repetir sem novo ID.');
 11    END IF;
 12  
 13    EXECUTE IMMEDIATE q'~
 14      CREATE TABLE BKP_RMD_ALH_DUP_PPG_20260917 AS
 15      WITH R AS (
 16        SELECT
 17          'RMD_FDUP_ALH_2026091701' AS ID_EXECUCAO_MAPA,
 18          SYSTIMESTAMP AS DH_MAPA,
 19          SYS_CONTEXT('USERENV','SESSION_USER') AS USUARIO_MAPA,
 20          B.ID_EXECUCAO AS ID_PREFLIGHT,
 21          B.DH_EXECUCAO AS DH_PREFLIGHT,
 22          B.USUARIO_EXECUCAO AS USUARIO_PREFLIGHT,
 23          B.NUNOTA, B.CODEMP, B.NUMNOTA, B.SERIENOTA, B.DTNEG, B.DTMOV,
 24          B.DTENTSAI, B.CODPARC, B.CODTIPOPER, B.CODTIPVENDA, B.DHTIPOPER,
 25          B.CODVEND, B.CODNAT AS CODNAT_CAB, B.CODCENCUS AS CODCENCUS_CAB,
 26          B.CODPROJ AS CODPROJ_CAB, B.RATEADO AS RATEADO_CAB, B.TIPMOV,
 27          B.VLRNOTA, B.VDUP_XML, B.DVENC_XML, B.NDUP_XML,
 28          B.STATUS_PREFLIGHT,
 29          P.TIPOEMP, P.CODEMP AS CODEMP_PPG, P.TIPOPAR,
 30          P.CODPARC AS CODPARC_PPG, P.SEQUENCIA AS SEQ_PPG,
 31          P.PRAZO, P.CODTIPTITPAD, P.CODBCOPAD, P.CODCTABCOINT,
 32          P.CODCENCUSPAD, P.CODNATPAD, P.CODPROJPAD, P.TIPRECDESP,
 33          P.TIPOFIN, P.PERCENTUAL,
 34          COUNT(P.CODTIPVENDA) OVER (PARTITION BY B.NUNOTA) AS QTD_PPG,
 35          COUNT(P.SEQUENCIA) OVER (PARTITION BY B.NUNOTA, P.SEQUENCIA) AS QTD_PPG_SEQ,
 36          (SELECT COUNT(*) FROM TGFTPV V
 37            WHERE V.CODTIPVENDA=B.CODTIPVENDA AND V.DHALTER=B.DHTIPOPER) AS QTD_TGFTPV_EXATA,
 38          (SELECT COUNT(*) FROM TGFFIN F WHERE F.NUNOTA=B.NUNOTA) AS QTD_TGFFIN_ATUAL,
 39          (SELECT COUNT(*) FROM TGFNUM N WHERE N.ARQUIVO='TGFFIN') AS QTD_TGFNUM_TGFFIN,
 40          (SELECT MAX(N.ULTCOD) FROM TGFNUM N WHERE N.ARQUIVO='TGFFIN') AS ULTCOD_TGFNUM_ATUAL,
 41          (SELECT MIN(A.CODCTABCOINT) FROM TSICTA A
 42            WHERE A.ATIVA='S' AND A.CODEMP=B.CODEMP) AS CODCTABCOINT_ATIVA
 43        FROM BKP_RMD_ALH_DUP_20260917 B
 44        LEFT JOIN TGFPPG P ON P.CODTIPVENDA=B.CODTIPVENDA
 45       WHERE B.ID_EXECUCAO='RMD_FDUP_ALH_2026091701'
 46      ), R2 AS (
 47        SELECT R.*,
 48               NVL(R.CODCTABCOINT,R.CODCTABCOINT_ATIVA) AS CODCTABCOINT_RESOLVIDO,
 49               NVL(R.CODBCOPAD,0) AS CODBCO_RESOLVIDO,
 50               CASE
 51                 WHEN UPPER(TRIM(R.TIPRECDESP)) IN ('I','R','1') THEN 1
 52                 WHEN UPPER(TRIM(R.TIPRECDESP)) IN ('D','P','-1') THEN -1
 53                 WHEN R.TIPMOV='V' THEN 1
 54                 WHEN R.TIPMOV='C' THEN -1
 55                 ELSE 0
 56               END AS RECDESP_RESOLVIDO,
 57               CASE WHEN UPPER(TRIM(R.TIPJURO_TPV))='I' THEN 1 ELSE 0 END AS TIPJURO_RESOLVIDO,
 58               NVL(R.CODCENCUSPAD,R.CODCENCUS_CAB) AS CODCENCUS_RESOLVIDO,
 59               NVL(R.CODNATPAD,R.CODNAT_CAB) AS CODNAT_RESOLVIDO,
 60               NVL(R.CODPROJPAD,R.CODPROJ_CAB) AS CODPROJ_RESOLVIDO
 61          FROM (
 62            SELECT R0.*,
 63                   (SELECT MAX(V.TIPJURO) FROM TGFTPV V
 64                     WHERE V.CODTIPVENDA=R0.CODTIPVENDA AND V.DHALTER=R0.DHTIPOPER) AS TIPJURO_TPV
 65              FROM R R0
 66          ) R
 67      )
 68      SELECT R2.*,
 69             CASE
 70               WHEN R2.STATUS_PREFLIGHT <> 'CANDIDATO_XML_VALIDO' THEN R2.STATUS_PREFLIGHT
 71               WHEN R2.QTD_PPG=0 THEN 'SEM_TGFPPG'
 72               WHEN R2.QTD_PPG<>1 THEN 'REVISAR_MULTIPLAS_PARCELAS'
 73               WHEN R2.QTD_PPG_SEQ<>1 THEN 'REVISAR_DUPLICIDADE_TGFPPG'
 74               WHEN R2.CODTIPTITPAD IS NULL THEN 'SEM_CODTIPTITPAD'
 75               WHEN NOT EXISTS (SELECT 1 FROM TGFTIT T WHERE T.CODTIPTIT=R2.CODTIPTITPAD)
 76                 THEN 'CODTIPTITPAD_INVALIDO'
 77               WHEN R2.QTD_TGFTPV_EXATA<>1 THEN 'REVISAR_TGFTPV_EXATA'
 78               WHEN R2.QTD_TGFNUM_TGFFIN<>1 THEN 'REVISAR_TGFNUM'
 79               WHEN R2.QTD_TGFFIN_ATUAL<>0 THEN 'TGFFIN_JA_EXISTE'
 80               WHEN R2.CODCTABCOINT_RESOLVIDO IS NULL THEN 'SEM_CONTA_ATIVA'
 81               WHEN R2.RECDESP_RESOLVIDO=0 THEN 'SEM_RECDESP'
 82               ELSE 'APTO_PARA_INSERCAO_CONTROLADA'
 83             END AS STATUS_MAPA,
 84             CASE
 85               WHEN R2.QTD_PPG=0 THEN 'TGFPPG ausente para CODTIPVENDA.'
 86               WHEN R2.QTD_PPG<>1 THEN 'Mais de uma condicao TGFPPG; nao inserir genericamente.'
 87               WHEN R2.CODTIPTITPAD IS NULL THEN 'CODTIPTIT deve ser derivado de TGFPPG.CODTIPTITPAD.'
 88               WHEN R2.QTD_TGFNUM_TGFFIN<>1 THEN 'TGFNUM deve ter exatamente uma linha TGFFIN.'
 89               ELSE 'Revisar candidato e validar antes do INSERT.'
 90             END AS OBSERVACAO
 91        FROM R2
 92    ~';
 93    COMMIT;
 94  END;
 95  /

PL/SQL procedure successfully completed.

