=== CARD 09 - PREFLIGHT E BACKUP PERSISTENTE ===
SQL> PROMPT ID_EXECUCAO=RMD_FDUP_ALH_2026091701
ID_EXECUCAO=RMD_FDUP_ALH_2026091701
SQL> 
SQL> DECLARE
  2    v_exists NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO v_exists
  5      FROM ALL_TABLES
  6     WHERE OWNER = SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
  7       AND TABLE_NAME = 'BKP_RMD_ALH_DUP_20260917';
  8    IF v_exists > 0 THEN
  9      RAISE_APPLICATION_ERROR(-20320,
 10        'BKP_RMD_ALH_DUP_20260917 ja existe; nao repetir sem novo ID.');
 11    END IF;
 12  
 13    EXECUTE IMMEDIATE q'~
 14      CREATE TABLE BKP_RMD_ALH_DUP_20260917 AS
 15      WITH X AS (
 16        SELECT C.NUNOTA, C.CODEMP, C.NUMNOTA, C.SERIENOTA, C.DTNEG, C.DTMOV,
 17               C.DTENTSAI, C.CODPARC, C.CODTIPOPER, C.CODTIPVENDA,
 18               C.DHTIPOPER, C.CODVEND, C.CODNAT, C.CODCENCUS, C.CODPROJ,
 19               C.RATEADO, C.TIPMOV, C.VLRNOTA,
 20               T.ATUALFIN,
 21               FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'vDup','dup') AS VDUP_XML,
 22               FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'dVenc','dup') AS DVENC_XML,
 23               FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'nDup','dup') AS NDUP_XML
 24          FROM TGFCAB C
 25          JOIN TGFTOP T
 26            ON T.CODTIPOPER = C.CODTIPOPER
 27           AND T.DHALTER = (
 28                 SELECT MAX(T2.DHALTER)
 29                   FROM TGFTOP T2
 30                  WHERE T2.CODTIPOPER = C.CODTIPOPER
 31                    AND T2.DHALTER <= C.DHTIPOPER
 32               )
 33         WHERE T.ATUALFIN <> 0
 34           AND C.TIPMOV <> 'Z'
 35           AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA = C.NUNOTA)
 36      )
 37      SELECT 'RMD_FDUP_ALH_2026091701' AS ID_EXECUCAO,
 38             SYSTIMESTAMP AS DH_EXECUCAO,
 39             SYS_CONTEXT('USERENV','SESSION_USER') AS USUARIO_EXECUCAO,
 40             X.*,
 41             CASE
 42               WHEN X.VDUP_XML IS NULL THEN 'SEM_DUP_XML'
 43               WHEN X.DVENC_XML IS NULL THEN 'SEM_DVENC_XML'
 44               WHEN NOT REGEXP_LIKE(TRIM(X.VDUP_XML), '^[0-9]+([.][0-9]+)?$')
 45                 THEN 'VDUP_XML_INVALIDO'
 46               WHEN NOT REGEXP_LIKE(TRIM(X.DVENC_XML), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
 47                 THEN 'DVENC_XML_INVALIDO'
 48               ELSE 'CANDIDATO_XML_VALIDO'
 49             END AS STATUS_PREFLIGHT
 50        FROM X
 51    ~';
 52    COMMIT;
 53  END;
 54  /

