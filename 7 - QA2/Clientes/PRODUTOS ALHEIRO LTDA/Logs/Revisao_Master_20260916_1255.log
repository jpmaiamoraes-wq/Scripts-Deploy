SQL> SELECT COUNT(*) CANDIDATOS_CARD13_TOPS_GOL
  2    FROM TGFTOP T
  3   WHERE DECODE(NVL(T.GOLSINAL,99999),
  4                NVL(CASE WHEN T.ATUALEST='B' AND T.TIPMOV='V' AND T.ATUALFIN=1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN -1
  5                         WHEN T.ATUALEST='E' AND T.TIPMOV='D' AND T.ATUALFIN=-1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN -1
  6                         WHEN T.ATUALEST='E' AND T.TIPMOV='C' AND T.ATUALFIN=-1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 1
  7                         WHEN T.ATUALEST='B' AND T.TIPMOV='E' AND T.ATUALFIN=1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 1
  8                         ELSE 0 END,99999),0,1)
  9         + DECODE(NVL(T.GOLMPSINAL,99999),
 10                NVL(CASE WHEN T.ATUALEST='B' AND T.TIPMOV='V' AND T.ATUALFIN=1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN -1
 11                         WHEN T.ATUALEST='E' AND T.TIPMOV='D' AND T.ATUALFIN=-1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN -1
 12                         WHEN T.ATUALEST='E' AND T.TIPMOV='C' AND T.ATUALFIN=-1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 1
 13                         WHEN T.ATUALEST='B' AND T.TIPMOV='E' AND T.ATUALFIN=1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 1
 14                         ELSE 0 END,99999),0,1)
 15         + DECODE(NVL(T.GOLDEV,99999),
 16                NVL(CASE WHEN T.TIPMOV IN ('D','E') AND T.ATUALEST IN ('E','B') AND T.CODMODDOC IN (55,59,65) AND (T.ATUALFIN<>0 OR T.TIPATUALFIN<>'P') THEN -1 ELSE 1 END,99999),0,1)
 17         + DECODE(NVL(T.ANALISEGIRO,99999),
 18                NVL(CASE WHEN T.TIPMOV='V' AND T.ATUALEST='B' AND T.ATUALFIN=1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN -1
 19                         WHEN T.TIPMOV='D' AND T.ATUALEST='E' AND T.ATUALFIN=-1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 1
 20                         ELSE 0 END,99999),0,1)
 21         + DECODE(NVL(T.ATUALULTIMAVEND,'#'),
 22                NVL(CASE WHEN T.TIPMOV='V' AND T.ATUALEST='B' AND T.ATUALFIN=1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 'G' ELSE 'N' END,'#'),0,1)
 23         + DECODE(NVL(T.ATUALULTIMACOMP,'#'),
 24                NVL(CASE WHEN T.TIPMOV='C' AND T.ATUALEST='E' AND T.ATUALFIN=-1 AND T.TIPATUALFIN='I' AND T.CODMODDOC IN (55,59,65) THEN 'E' ELSE 'N' END,'#'),0,1) > 0;

