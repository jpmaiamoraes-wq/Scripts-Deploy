SQL> PROMPT === VALIDACAO AUTOMATIZADA ===
=== VALIDACAO AUTOMATIZADA ===
SQL> DECLARE
  2    v_status VARCHAR2(30);
  3    v_errors NUMBER;
  4    v_backup NUMBER;
  5    v_map NUMBER;
  6    v_aptas NUMBER;
  7    v_audit NUMBER;
  8    v_fin NUMBER;
  9    v_num NUMBER;
 10    v_ultcod NUMBER;
 11    v_map_num NUMBER;
 12    v_map_ultcod NUMBER;
 13  BEGIN
 14    SELECT MAX(STATUS) INTO v_status
 15      FROM ALL_OBJECTS
 16     WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
 17       AND OBJECT_NAME='FNC_BUSCA_TAG_XML_GERAL'
 18       AND OBJECT_TYPE='FUNCTION';
 19    SELECT COUNT(*) INTO v_errors
 20      FROM ALL_ERRORS
 21     WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
 22       AND NAME='FNC_BUSCA_TAG_XML_GERAL'
 23       AND TYPE='FUNCTION';
 24    SELECT COUNT(*) INTO v_backup
 25      FROM BKP_RMD_ALH_DUP_20260917
 26     WHERE ID_EXECUCAO='RMD_FDUP_ALH_2026091701';
 27    SELECT COUNT(*) INTO v_map
 28      FROM BKP_RMD_ALH_DUP_PPG_20260917
 29     WHERE ID_EXECUCAO_MAPA='RMD_FDUP_ALH_2026091701';
 30    SELECT COUNT(*) INTO v_aptas
 31      FROM BKP_RMD_ALH_DUP_PPG_20260917
 32     WHERE ID_EXECUCAO_MAPA='RMD_FDUP_ALH_2026091701'
 33       AND STATUS_MAPA='APTO_PARA_INSERCAO_CONTROLADA';
 34    SELECT COUNT(*) INTO v_audit
 35      FROM BKP_RMD_ALH_DUP_INS_20260917
 36     WHERE ID_EXECUCAO='RMD_FDUP_ALH_2026091701';
 37    SELECT COUNT(*) INTO v_fin
 38      FROM TGFFIN F
 39     WHERE EXISTS (SELECT 1 FROM BKP_RMD_ALH_DUP_PPG_20260917 M
 40                    WHERE M.ID_EXECUCAO_MAPA='RMD_FDUP_ALH_2026091701'
 41                      AND M.NUNOTA=F.NUNOTA);
 42    SELECT COUNT(*), NVL(MAX(ULTCOD),-1)
 43      INTO v_num, v_ultcod
 44      FROM TGFNUM WHERE ARQUIVO='TGFFIN';
 45    SELECT NVL(MIN(QTD_TGFNUM_TGFFIN),-1), NVL(MIN(ULTCOD_TGFNUM_ATUAL),-1)
 46      INTO v_map_num, v_map_ultcod
 47      FROM BKP_RMD_ALH_DUP_PPG_20260917
 48     WHERE ID_EXECUCAO_MAPA='RMD_FDUP_ALH_2026091701';
 49  
 50    DBMS_OUTPUT.PUT_LINE('FUNCAO_STATUS='||NVL(v_status,'AUSENTE'));
 51    DBMS_OUTPUT.PUT_LINE('FUNCAO_ERROS='||v_errors);
 52    DBMS_OUTPUT.PUT_LINE('BACKUP_LINHAS='||v_backup||'; MAPA_LINHAS='||v_map);
 53    DBMS_OUTPUT.PUT_LINE('LINHAS_APTAS='||v_aptas||'; AUDITORIA_INSERCOES='||v_audit);
 54    DBMS_OUTPUT.PUT_LINE('TGFFIN_ATUAL_NOTAS_ESCUPO='||v_fin);
 55    DBMS_OUTPUT.PUT_LINE('TGFNUM_ATUAL='||v_num||'; ULTCOD_ATUAL='||v_ultcod||
 56                         '; TGFNUM_MAPA='||v_map_num||'; ULTCOD_MAPA='||v_map_ultcod);
 57  
 58    IF v_status<>'VALID' OR v_errors<>0 OR v_backup<>1 OR v_map<>1 OR
 59       v_aptas<>0 OR v_audit<>0 OR v_fin<>0 OR v_num<>1 OR v_ultcod<>v_map_ultcod THEN
 60      RAISE_APPLICATION_ERROR(-20539,
 61        'Pos-validacao do Card 09 falhou; revisar log antes de concluir.');
 62    END IF;
 63    DBMS_OUTPUT.PUT_LINE('ERROS_VALIDACAO=0');
 64    DBMS_OUTPUT.PUT_LINE('STATUS=CONCLUIDA_SEM_DML_TGFFIN');
 65  END;
 66  /
FUNCAO_STATUS=VALID
FUNCAO_ERROS=0
BACKUP_LINHAS=1; MAPA_LINHAS=1
LINHAS_APTAS=0; AUDITORIA_INSERCOES=0
TGFFIN_ATUAL_NOTAS_ESCUPO=0
TGFNUM_ATUAL=1; ULTCOD_ATUAL=38210; TGFNUM_MAPA=1; ULTCOD_MAPA=38210
ERROS_VALIDACAO=0
STATUS=CONCLUIDA_SEM_DML_TGFFIN


