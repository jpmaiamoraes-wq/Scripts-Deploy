SQL> SELECT CHAVE,
  2         REGEXP_SUBSTR(TEXTO, '[^;]+', 1, 1) AS SERVIDOR_PORTA,
  3         REGEXP_SUBSTR(TEXTO, '[^;]+', 1, 2) AS CRIPTOGRAFIA,
  4         REGEXP_SUBSTR(TEXTO, '[^;]+', 1, 3) AS REMETENTE,
  5         CASE
  6           WHEN TEXTO IS NULL THEN 'AUSENTE'
  7           WHEN REGEXP_COUNT(TEXTO, ';') >= 3 THEN 'CREDENCIAL_PRESENTE_NAO_EXIBIDA'
  8           ELSE 'FORMATO_INCOMPLETO'
  9         END AS CREDENCIAL
 10    FROM TSIPAR
 11   WHERE CHAVE = 'MSDSMTPPROP';

