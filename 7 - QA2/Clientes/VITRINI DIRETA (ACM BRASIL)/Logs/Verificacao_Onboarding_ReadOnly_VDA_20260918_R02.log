SQL> @@"/Users/spadarojr/Documents/Trabalho/Sankhya/Deploy Agent/Scripts-Deploy/7 - QA2/Revisao Master Deploy/Verificacao_Onboarding_ReadOnly.sql"
SQL> -- VERIFICACAO GENERICA DE ONBOARDING - SOMENTE LEITURA
SQL> --
SQL> -- Objetivo:
SQL> --   Fornecer o snapshot tecnico da base para confronto com os arquivos mais
SQL> --   recentes da pasta do cliente em "8. Onboarding Deploy".
SQL> --
SQL> -- Uso:
SQL> --   1. Executar conectado ao schema da base revisada.
SQL> --   2. Preservar a saida integral em log por cliente e data.
SQL> --   3. Confrontar os resultados com os arquivos do onboarding.
SQL> --   4. Registrar divergencias comprovadas, sem transformar linhas de modelo
SQL> --      ou registros adicionais da base em erro automatico.
SQL> --
SQL> -- Seguranca:
SQL> --   - Este roteiro nao contem DML, DDL, COMMIT ou senha.
SQL> --   - Credenciais SMTP nunca sao exibidas; somente metadados e presenca.
SQL> --   - Nao preencher tabelas temporarias nem alterar a base para comparar.
SQL> 
SQL> SET DEFINE OFF
SQL> SET ECHO ON
SQL> SET FEEDBACK ON
SQL> SET HEADING ON
SQL> SET LINESIZE 240
SQL> SET LONG 2000
SQL> SET PAGESIZE 1000
SQL> SET TAB OFF
SQL> SET VERIFY OFF
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> 
