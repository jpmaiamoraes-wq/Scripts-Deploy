SQL> DECLARE
  2    v_qtd NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO v_qtd
  5      FROM ALL_TABLES
  6     WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
  7       AND TABLE_NAME='BKP_VDA_FDUP_20260918';
  8    IF v_qtd>0 THEN
  9      RAISE_APPLICATION_ERROR(-20601,'Tabela BKP_VDA_FDUP_20260918 ja existe; use novo ID antes de repetir.');
 10    END IF;
 11
 12    EXECUTE IMMEDIATE q'[
 13      CREATE TABLE BKP_VDA_FDUP_20260918 AS
 14      WITH N AS (
 15        SELECT NUNOTA, XML,
 16               ROW_NUMBER() OVER(PARTITION BY NUNOTA ORDER BY ROWID) AS RN
 17          FROM TGFNFE
 18      )
 19      SELECT
 20        CAST('VDA_FDUP_20260918_01' AS VARCHAR2(40)) AS ID_EXECUCAO,
 21        SYSTIMESTAMP AS DH_EXECUCAO,
 22        SYS_CONTEXT('USERENV','SESSION_USER') AS USUARIO_EXECUCAO,
 23        C.NUNOTA, C.CODEMP, C.NUMNOTA, C.SERIENOTA, C.DTNEG, C.DTMOV,
 24        C.CODPARC, C.CODTIPOPER, T.DESCROPER, C.VLRNOTA,
 25        X.VDUP_XML, X.DVENC_XML, X.NDUP_XML
 26      FROM TGFCAB C
 27      JOIN TGFTOP T
 28        ON T.CODTIPOPER=C.CODTIPOPER
 29       AND T.DHALTER=(
 30         SELECT MAX(T2.DHALTER)
 31           FROM TGFTOP T2
 32          WHERE T2.CODTIPOPER=C.CODTIPOPER
 33            AND T2.DHALTER<=C.DHTIPOPER
 34       )
 35      LEFT JOIN N
 36        ON N.NUNOTA=C.NUNOTA
 37       AND N.RN=1
 38      OUTER APPLY XMLTABLE(
 39        '//*[local-name()="dup"][1]'
 40        PASSING XMLTYPE(N.XML)
 41        COLUMNS
 42          VDUP_XML  VARCHAR2(4000) PATH '*[local-name()="vDup"][1]/text()',
 43          DVENC_XML VARCHAR2(4000) PATH '*[local-name()="dVenc"][1]/text()',
 44          NDUP_XML  VARCHAR2(4000) PATH '*[local-name()="nDup"][1]/text()'
 45      ) X
 46      WHERE T.ATUALFIN<>0
 47        AND C.TIPMOV<>'Z'
 48        AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA=C.NUNOTA)
 49    ]';
 50  END;
 51  /
 52
 53  PROMPT === RESUMO DO PREFLIGHT DIRETO XML ===
 54  SELECT COUNT(*) AS NOTAS_SEM_FINANCEIRO_TOTAL
 55    FROM BKP_VDA_FDUP_20260918;
 56
 57  SELECT COUNT(*) AS CANDIDATOS_DUP_DVENC_VALIDOS
 58    FROM BKP_VDA_FDUP_20260918
 59   WHERE VDUP_XML IS NOT NULL
 60     AND REGEXP_LIKE(DVENC_XML,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
 61
 62  SELECT COUNT(*) AS SEM_DUP_PARA_ANALISE
 63    FROM BKP_VDA_FDUP_20260918
 64   WHERE VDUP_XML IS NULL;
 65
 66  SELECT COUNT(*) AS DUP_COM_XML_INVALIDO
 67    FROM BKP_VDA_FDUP_20260918
 68   WHERE VDUP_XML IS NOT NULL
 69     AND NOT REGEXP_LIKE(DVENC_XML,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
 70
 71  SELECT CODTIPOPER,DESCROPER,COUNT(*) AS CANDIDATOS
 72    FROM BKP_VDA_FDUP_20260918
 73   WHERE VDUP_XML IS NOT NULL
 74     AND REGEXP_LIKE(DVENC_XML,'^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
 75   GROUP BY CODTIPOPER,DESCROPER
 76   ORDER BY CODTIPOPER;
 77
