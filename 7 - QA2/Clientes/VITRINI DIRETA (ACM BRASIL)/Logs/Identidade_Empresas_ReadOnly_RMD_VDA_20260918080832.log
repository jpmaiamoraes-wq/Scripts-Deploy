SQL> PROMPT === EMPRESAS RELACIONADAS A VITRIN/ACM ===
=== EMPRESAS RELACIONADAS A VITRIN/ACM ===
SQL> SELECT CODEMP, NOMEFANTASIA, RAZAOSOCIAL
  2    FROM TSIEMP
  3   WHERE UPPER(NVL(NOMEFANTASIA,' ')) LIKE '%VITRIN%'
  4      OR UPPER(NVL(NOMEFANTASIA,' ')) LIKE '%ACM%'
  5      OR UPPER(NVL(RAZAOSOCIAL,' ')) LIKE '%VITRIN%'
  6      OR UPPER(NVL(RAZAOSOCIAL,' ')) LIKE '%ACM%'
  7   ORDER BY CODEMP;

    CODEMP NOMEFANTASIA                             RAZAOSOCIAL
