SQL> WITH CANDIDATES AS (
  2    SELECT
  3      C.NUNOTA, C.CODEMP, C.NUMNOTA, C.SERIENOTA, C.DTNEG, C.DTMOV,
  4      C.CODPARC, C.CODTIPOPER, T.DESCROPER, C.VLRNOTA
  5    FROM TGFCAB C
  6    JOIN TGFTOP T
  7      ON C.CODTIPOPER=T.CODTIPOPER
  8     AND C.DHTIPOPER=T.DHALTER
  9    WHERE T.ATUALFIN<>0
 10      AND C.TIPMOV<>'Z'
 11      AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA=C.NUNOTA)
 12  ), N AS (
 13    SELECT N.NUNOTA, N.XML,
 14           ROW_NUMBER() OVER(PARTITION BY N.NUNOTA ORDER BY N.ROWID) AS RN
 15    FROM TGFNFE N
 16    JOIN CANDIDATES C
 17      ON C.NUNOTA=N.NUNOTA
 18  )
 19  SELECT
 20    C.NUNOTA, C.CODEMP, C.NUMNOTA, C.SERIENOTA, C.CODTIPOPER,
 21    C.DESCROPER, C.VLRNOTA,
 22    X.VDUP_XML, X.DVENC_XML, X.NDUP_XML
 23  FROM CANDIDATES C
 24  LEFT JOIN N
 25    ON N.NUNOTA=C.NUNOTA
 26   AND N.RN=1
 27  OUTER APPLY XMLTABLE(
 28    '//*[local-name()="dup"][1]'
 29    PASSING XMLTYPE(N.XML)
 30    COLUMNS
 31      VDUP_XML  VARCHAR2(4000) PATH '*[local-name()="vDup"][1]/text()',
 32      DVENC_XML VARCHAR2(4000) PATH '*[local-name()="dVenc"][1]/text()',
 33      NDUP_XML  VARCHAR2(4000) PATH '*[local-name()="nDup"][1]/text()'
 34  ) X
 35  ORDER BY C.NUNOTA;

