SQL> PROMPT CANDIDATOS=QUERY_DASHBOARD; EXTRACAO=XMLTABLE; TGFFIN_ALTERADO=NAO
CANDIDATOS=QUERY_DASHBOARD; EXTRACAO=XMLTABLE; TGFFIN_ALTERADO=NAO
SQL>
SQL> SELECT COUNT(*) AS CANDIDATOS_SEM_FINANCEIRO
  2    FROM TGFCAB C
  3    JOIN TGFTOP T
  4      ON C.CODTIPOPER=T.CODTIPOPER
  5     AND C.DHTIPOPER=T.DHALTER
  6   WHERE T.ATUALFIN<>0
  7     AND C.TIPMOV<>'Z'
  8     AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA=C.NUNOTA);

