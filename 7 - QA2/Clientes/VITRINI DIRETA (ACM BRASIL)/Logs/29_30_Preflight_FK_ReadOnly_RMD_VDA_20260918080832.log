=== RESUMO DOS GRUPOS DE COLISAO ===
SQL> SELECT 'TSIBAI_GRUPOS_COLISAO' ITEM,COUNT(*) QTD
  2    FROM (
  3      SELECT REGEXP_REPLACE(TRIM(TRANSLATE(UPPER(NOMEBAI),
  4        'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC')),' {2,}',' ') N
  5        FROM TSIBAI
  6       WHERE NOMEBAI IS NOT NULL
  7       GROUP BY REGEXP_REPLACE(TRIM(TRANSLATE(UPPER(NOMEBAI),
  8        'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC')),' {2,}',' ')
  9      HAVING COUNT(*)>1
 10    )
 11  UNION ALL
 12  SELECT 'TSIEND_GRUPOS_COLISAO' ITEM,COUNT(*) QTD
 13    FROM (
 14      SELECT TIPO,REGEXP_REPLACE(TRIM(TRANSLATE(UPPER(NOMEEND),
 15        'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC')),' {2,}',' ') N
 16        FROM TSIEND
 17       WHERE NOMEEND IS NOT NULL
 18       GROUP BY TIPO,REGEXP_REPLACE(TRIM(TRANSLATE(UPPER(NOMEEND),
 19        'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC')),' {2,}',' ')
 20      HAVING COUNT(*)>1
 21    );

