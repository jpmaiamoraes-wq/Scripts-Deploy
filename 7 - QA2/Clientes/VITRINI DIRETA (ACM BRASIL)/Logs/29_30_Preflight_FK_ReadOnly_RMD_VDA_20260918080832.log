SQL> PROMPT === FKS PARA TSIBAI/TSIEND, INCLUSIVE COMPOSTAS ===
=== FKS PARA TSIBAI/TSIEND, INCLUSIVE COMPOSTAS ===
SQL> SELECT C.OWNER,C.TABLE_NAME,C.CONSTRAINT_NAME,CC.POSITION,CC.COLUMN_NAME,
  2         P.TABLE_NAME REFERENCED_TABLE,PC.COLUMN_NAME REFERENCED_COLUMN
  3    FROM ALL_CONSTRAINTS C
  4    JOIN ALL_CONS_COLUMNS CC
  5      ON CC.OWNER=C.OWNER AND CC.CONSTRAINT_NAME=C.CONSTRAINT_NAME
  6    JOIN ALL_CONSTRAINTS P
  7      ON P.OWNER=C.R_OWNER AND P.CONSTRAINT_NAME=C.R_CONSTRAINT_NAME
  8    LEFT JOIN ALL_CONS_COLUMNS PC
  9      ON PC.OWNER=P.OWNER AND PC.CONSTRAINT_NAME=P.CONSTRAINT_NAME
 10     AND PC.POSITION=CC.POSITION
 11   WHERE C.OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
 12     AND C.CONSTRAINT_TYPE='R'
 13     AND P.OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
 14     AND P.TABLE_NAME IN ('TSIBAI','TSIEND')
 15   ORDER BY C.TABLE_NAME,C.CONSTRAINT_NAME,CC.POSITION;

