      "TEXTO": "            V_USUARIOSIS    VARCHAR2(60);\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 19,
      "TEXTO": "            V_CODUSUAUX     VARCHAR2(100);\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 20,
      "TEXTO": "BEGIN \n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 21,
      "TEXTO": "    IF (P_CODUSU IS NULL) OR (P_CODUSU = 0) OR (P_TABELA = 'TSIUSU') THEN\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 22,
      "TEXTO": "      V_CODUSUAUX := Tsiusu_Log_Pkg.V_CODUSULOG;\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 23,
      "TEXTO": "      V_USUARIOSIS := Tsiusu_Log_Pkg.V_NOMEUSULOG;\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 24,
      "TEXTO": "    ELSE\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 25,
      "TEXTO": "      V_CODUSUAUX := P_CODUSU;\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 26,
      "TEXTO": "      BEGIN\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 27,
      "TEXTO": "        SELECT USU.NOMEUSU INTO V_USUARIOSIS FROM TSIUSU USU WHERE USU.CODUSU = V_CODUSUAUX;\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 28,
      "TEXTO": "      EXCEPTION WHEN NO_DATA_FOUND THEN\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 29,
      "TEXTO": "        V_USUARIOSIS := 'USUARIO NAO LOCALIZADO NA TSIUSU ' || V_CODUSUAUX;\n"
    },
    {
      "TIPO": "PROCEDURE",
      "OBJETO": "STP_GRAVATABLOG",
      "LINHA": 30,
      "TEXTO": "      END;\n"
    },
