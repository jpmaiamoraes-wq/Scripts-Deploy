    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 1,
      "TEXTO": "TRIGGER \"SANKHYA\".\"TRG_INC_UPD_DLT_TSIPAR_LOG\" BEFORE  INSERT OR UPDATE OR DELETE  ON TSIPAR FOR EACH ROW\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 2,
      "TEXTO": "DECLARE P_ACAO VARCHAR2(10); P_CHAVEPK VARCHAR(400);\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 3,
      "TEXTO": "BEGIN\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 4,
      "TEXTO": "  P_CHAVEPK := 'PK [' || 'CHAVE' || '=' || :NEW.CHAVE  || 'CODUSU' || '=' || :NEW.CODUSU || ']';\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 5,
      "TEXTO": "  IF INSERTING THEN  \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 6,
      "TEXTO": "    IF :NEW.ABA IS NOT NULL THEN   \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 7,
      "TEXTO": "      STP_GRAVATABLOG('TSIPAR', P_CHAVEPK,'ABA',:NEW.CODUSU,'INSERT',:NEW.ABA,' ');\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 8,
      "TEXTO": "    END IF;  \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 9,
      "TEXTO": "    IF :NEW.CHAVE IS NOT NULL THEN   \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 10,
      "TEXTO": "      STP_GRAVATABLOG('TSIPAR', P_CHAVEPK,'CHAVE',:NEW.CODUSU,'INSERT',:NEW.CHAVE,' ');\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 11,
      "TEXTO": "    END IF;  \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 12,
      "TEXTO": "    IF :NEW.CLASSE IS NOT NULL THEN   \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 13,
      "TEXTO": "      STP_GRAVATABLOG('TSIPAR', P_CHAVEPK,'CLASSE',:NEW.CODUSU,'INSERT',:NEW.CLASSE,' ');\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 14,
      "TEXTO": "    END IF;  \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 15,
      "TEXTO": "    IF :NEW.CODUSU IS NOT NULL THEN   \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 16,
      "TEXTO": "      STP_GRAVATABLOG('TSIPAR', P_CHAVEPK,'CODUSU',:NEW.CODUSU,'INSERT',:NEW.CODUSU,' ');\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 17,
      "TEXTO": "    END IF;  \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 18,
      "TEXTO": "    IF TO_CHAR(:NEW.DATA,'dd/mm/yyyy hh24:mm:ss') IS NOT NULL THEN   \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 19,
      "TEXTO": "      STP_GRAVATABLOG('TSIPAR', P_CHAVEPK,'DATA',:NEW.CODUSU,'INSERT',TO_CHAR(:NEW.DATA,'dd/mm/yyyy hh24:mm:ss'),' ');\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 20,
      "TEXTO": "    END IF;  \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 21,
      "TEXTO": "    IF :NEW.DESCRICAO IS NOT NULL THEN   \n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 22,
      "TEXTO": "      STP_GRAVATABLOG('TSIPAR', P_CHAVEPK,'DESCRICAO',:NEW.CODUSU,'INSERT',:NEW.DESCRICAO,' ');\n"
    },
    {
      "TIPO": "TRIGGER",
      "OBJETO": "TRG_INC_UPD_DLT_TSIPAR_LOG",
      "LINHA": 23,
      "TEXTO": "    END IF;  \n"
