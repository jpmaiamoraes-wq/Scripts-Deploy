SQL> WITH b AS (SELECT CODBAI,NOMEBAI,REGEXP_REPLACE(TRIM(TRANSLATE(UPPER(NOMEBAI),'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇáàâãäéèêëíìîïóòôõöúùûüçÃãÕõÂâÊêÎîÔôÛû','AAAAAEEEEIIIIOOOOOUUUUCAAAAAEEEEIIIIOOOOOUUUUCAAAOOAAEIIOOUU')),' {2,}',' ') NORM FROM TSIBAI) SELECT NORM,COUNT(*) QTD,MIN(CODBAI) COD_MANTIDO,LISTAGG(CODBAI||'='||NOMEBAI,' | ') WITHIN GROUP(ORDER BY CODBAI) REGISTROS FROM b GROUP BY NORM HAVING COUNT(*)>1 ORDER BY NORM;

