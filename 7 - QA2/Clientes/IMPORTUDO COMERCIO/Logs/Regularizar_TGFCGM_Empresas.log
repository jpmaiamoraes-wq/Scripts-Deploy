SQL> PROMPT ETAPA18_TGFCGM_UMA_LINHA_POR_EMPRESA_IMPORTUDO
ETAPA18_TGFCGM_UMA_LINHA_POR_EMPRESA_IMPORTUDO
SQL> DECLARE
  2    v_id CONSTANT VARCHAR2(40):='RMD_TGFCGM_IMPORTUDO_20260911_01';
  3    v_src NUMBER; v_emp NUMBER; v_missing NUMBER; v_ins NUMBER; v_cols VARCHAR2(32767); v_sel VARCHAR2(32767); v_sql VARCHAR2(32767); v_n NUMBER;
  4  BEGIN
  5    SELECT COUNT(*) INTO v_src FROM TGFCGM WHERE CODEMP=1 AND ANO=1900 AND MES=1;
  6    IF v_src<>1 THEN RAISE_APPLICATION_ERROR(-20310,'TGFCGM origem CODEMP=1/ANO=1900/MES=1 deve ter exatamente 1 linha.'); END IF;
  7    SELECT COUNT(*) INTO v_emp FROM TSIEMP;
  8    SELECT COUNT(*) INTO v_missing FROM TSIEMP e WHERE NOT EXISTS (SELECT 1 FROM TGFCGM g WHERE g.CODEMP=e.CODEMP AND g.ANO=1900 AND g.MES=1);
  9    DBMS_OUTPUT.PUT_LINE('EMPRESAS='||v_emp||'; AUSENTES='||v_missing);
 10    SELECT LISTAGG('"'||COLUMN_NAME||'"',',') WITHIN GROUP (ORDER BY COLUMN_ID), LISTAGG('s."'||COLUMN_NAME||'"',',') WITHIN GROUP (ORDER BY COLUMN_ID) INTO v_cols,v_sel
 11      FROM ALL_TAB_COLUMNS WHERE OWNER='SANKHYA' AND TABLE_NAME='TGFCGM' AND COLUMN_NAME<>'CODEMP';
 12    IF v_cols IS NULL THEN RAISE_APPLICATION_ERROR(-20311,'Nao foi possivel obter colunas de TGFCGM.'); END IF;
 13    BEGIN
 14      SELECT COUNT(*) INTO v_n FROM ALL_TABLES WHERE OWNER='SANKHYA' AND TABLE_NAME='BKP_RMD_TGFCGM_INS';
 15      IF v_n=0 THEN EXECUTE IMMEDIATE 'CREATE TABLE SANKHYA.BKP_RMD_TGFCGM_INS (ID_EXECUCAO VARCHAR2(40),ROWID_ORIGINAL VARCHAR2(30),CODEMP NUMBER,ANO NUMBER,MES NUMBER)'; END IF;
 16    END;
 17    DELETE FROM SANKHYA.BKP_RMD_TGFCGM_INS WHERE ID_EXECUCAO=v_id;
 18    INSERT INTO SANKHYA.BKP_RMD_TGFCGM_INS(ID_EXECUCAO,ROWID_ORIGINAL,CODEMP,ANO,MES)
 19      SELECT v_id,NULL,e.CODEMP,1900,1 FROM TSIEMP e
 20      WHERE NOT EXISTS (SELECT 1 FROM TGFCGM g WHERE g.CODEMP=e.CODEMP AND g.ANO=1900 AND g.MES=1);
 21    v_sql:='INSERT INTO TGFCGM (CODEMP,'||v_cols||') SELECT e.CODEMP,'||v_sel||' FROM TSIEMP e CROSS JOIN (SELECT '||v_cols||' FROM TGFCGM WHERE CODEMP=1 AND ANO=1900 AND MES=1) s WHERE NOT EXISTS (SELECT 1 FROM TGFCGM x WHERE x.CODEMP=e.CODEMP AND x.ANO=s.ANO AND x.MES=s.MES)';
 22    EXECUTE IMMEDIATE v_sql; v_ins:=SQL%ROWCOUNT;
 23    UPDATE SANKHYA.BKP_RMD_TGFCGM_INS b SET ROWID_ORIGINAL=(SELECT ROWIDTOCHAR(g.ROWID) FROM TGFCGM g WHERE g.CODEMP=b.CODEMP AND g.ANO=b.ANO AND g.MES=b.MES) WHERE b.ID_EXECUCAO=v_id;
 24    IF v_ins<>v_missing THEN RAISE_APPLICATION_ERROR(-20312,'Insercoes divergentes: esperadas='||v_missing||', realizadas='||v_ins); END IF;
 25    SELECT COUNT(*) INTO v_n FROM SANKHYA.BKP_RMD_TGFCGM_INS WHERE ID_EXECUCAO=v_id AND ROWID_ORIGINAL IS NULL;
 26    IF v_n<>0 THEN RAISE_APPLICATION_ERROR(-20314,'Mapa sem ROWID para insercoes='||v_n); END IF;
 27    SELECT COUNT(*) INTO v_n FROM TSIEMP e WHERE NOT EXISTS (SELECT 1 FROM TGFCGM g WHERE g.CODEMP=e.CODEMP AND g.ANO=1900 AND g.MES=1);
 28    IF v_n<>0 THEN RAISE_APPLICATION_ERROR(-20313,'Empresas ainda sem TGFCGM='||v_n); END IF;
 29    COMMIT; DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||v_id||'; INSERIDAS='||v_ins||'; TGFCGM_TOTAL_EMPRESAS_OK='||v_emp);
 30  EXCEPTION WHEN OTHERS THEN ROLLBACK; DBMS_OUTPUT.PUT_LINE('ERRO_REVERTIDO='||SQLERRM); RAISE;
 31  END;
 32  /
EMPRESAS=4; AUSENTES=0
