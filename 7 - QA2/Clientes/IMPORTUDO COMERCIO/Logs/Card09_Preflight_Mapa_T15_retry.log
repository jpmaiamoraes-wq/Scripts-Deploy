SQL> @"/Users/spadarojr/Documents/Trabalho/Sankhya/Deploy Agent/Scripts-Deploy/7 - QA2/Clientes/IMPORTUDO COMERCIO/Artefatos_Revisao/Scripts/32_Card09_Preflight_Notas_Sem_Financeiro_DUP.sql"
SQL> -- Etapa 32 - Preflight do card 09 - Notas sem Financeiro.
SQL> --
SQL> -- Este script faz o preflight e cria um mapa persistente dos candidatos.
SQL> -- Este arquivo apenas cria o preflight; a inclusao controlada ocorre no 32B
SQL> -- apos a revisao do mapa e a confirmacao explicita do operador.
SQL> 
SQL> SET DEFINE ON
SQL> 
SQL> -- Parametros obrigatorios: altere os dois valores antes de executar.
SQL> DEFINE ID_EXECUCAO = 'BASE_YYYYMMDD_FIN_DUP_01'
SQL> DEFINE TBL_BASE = 'BKP_RMD_FDUP_BASE_YYYYMMDD'
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> SET SQLBLANKLINES ON
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> 
SQL> PROMPT === CARD 09 - PREFLIGHT NOTAS SEM FINANCEIRO COM DUP ===
=== CARD 09 - PREFLIGHT NOTAS SEM FINANCEIRO COM DUP ===
SQL> 
SQL> DECLARE
  2    v_qtd NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO v_qtd
  5      FROM ALL_TABLES
  6     WHERE OWNER = SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
  7       AND TABLE_NAME = '&TBL_BASE';
  8    IF v_qtd > 0 THEN
  9      RAISE_APPLICATION_ERROR(-20320,
 10        'Mapa &TBL_BASE já existe. Gere novo ID antes de repetir.');
 11    END IF;
 12  
 13    EXECUTE IMMEDIATE q'[
 14      CREATE TABLE &TBL_BASE AS
 15      SELECT
 16        CAST('&ID_EXECUCAO' AS VARCHAR2(40)) AS ID_EXECUCAO,
 17        SYSTIMESTAMP AS DH_EXECUCAO,
 18        SYS_CONTEXT('USERENV','SESSION_USER') AS USUARIO_EXECUCAO,
 19        C.NUNOTA, C.CODEMP, C.NUMNOTA, C.SERIENOTA, C.DTNEG, C.DTMOV,
 20        C.CODPARC, C.CODTIPOPER, T.DESCROPER, C.VLRNOTA,
 21        FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'vDup','dup') AS VDUP_XML,
 22        FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'dVenc','dup') AS DVENC_XML,
 23        FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'nDup','dup') AS NDUP_XML
 24      FROM TGFCAB C
 25      JOIN TGFTOP T
 26        ON T.CODTIPOPER = C.CODTIPOPER
 27       AND T.DHALTER = (
 28         SELECT MAX(T2.DHALTER)
 29           FROM TGFTOP T2
 30          WHERE T2.CODTIPOPER = C.CODTIPOPER
 31            AND T2.DHALTER <= C.DHTIPOPER
 32       )
 33      WHERE T.ATUALFIN <> 0
 34        AND C.TIPMOV <> 'Z'
 35        AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA = C.NUNOTA)
 36        AND FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'vDup','dup') IS NOT NULL
 37        AND REGEXP_LIKE(
 38              FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'dVenc','dup'),
 39              '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
 40            )
 41    ]';
 42  END;
 43  /

PL/SQL procedure successfully completed.

SQL> 
SQL> DECLARE
  2    v_total NUMBER;
  3    v_eligible NUMBER;
  4    v_without_dup NUMBER;
  5    v_invalid_xml NUMBER;
  6  BEGIN
  7    SELECT COUNT(*) INTO v_total
  8      FROM TGFCAB C
  9      JOIN TGFTOP T
 10        ON T.CODTIPOPER = C.CODTIPOPER
 11       AND T.DHALTER = (
 12         SELECT MAX(T2.DHALTER) FROM TGFTOP T2
 13          WHERE T2.CODTIPOPER = C.CODTIPOPER AND T2.DHALTER <= C.DHTIPOPER
 14       )
 15     WHERE T.ATUALFIN <> 0 AND C.TIPMOV <> 'Z'
 16       AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA = C.NUNOTA);
 17  
 18    SELECT COUNT(*) INTO v_eligible FROM &TBL_BASE;
 19  
 20    SELECT COUNT(*) INTO v_without_dup
 21      FROM TGFCAB C
 22      JOIN TGFTOP T
 23        ON T.CODTIPOPER = C.CODTIPOPER
 24       AND T.DHALTER = (
 25         SELECT MAX(T2.DHALTER) FROM TGFTOP T2
 26          WHERE T2.CODTIPOPER = C.CODTIPOPER AND T2.DHALTER <= C.DHTIPOPER
 27       )
 28     WHERE T.ATUALFIN <> 0 AND C.TIPMOV <> 'Z'
 29       AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA = C.NUNOTA)
 30       AND FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'vDup','dup') IS NULL;
 31  
 32    SELECT COUNT(*) INTO v_invalid_xml
 33      FROM TGFCAB C
 34      JOIN TGFTOP T
 35        ON T.CODTIPOPER = C.CODTIPOPER
 36       AND T.DHALTER = (
 37         SELECT MAX(T2.DHALTER) FROM TGFTOP T2
 38          WHERE T2.CODTIPOPER = C.CODTIPOPER AND T2.DHALTER <= C.DHTIPOPER
 39       )
 40     WHERE T.ATUALFIN <> 0 AND C.TIPMOV <> 'Z'
 41       AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA = C.NUNOTA)
 42       AND FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'vDup','dup') IS NOT NULL
 43       AND NOT REGEXP_LIKE(
 44             FNC_BUSCA_TAG_XML_GERAL(C.NUNOTA,'dVenc','dup'),
 45             '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
 46           );
 47  
 48    DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO=&ID_EXECUCAO');
 49    DBMS_OUTPUT.PUT_LINE('NOTAS_SEM_FINANCEIRO_TOTAL='||v_total);
 50    DBMS_OUTPUT.PUT_LINE('CANDIDATOS_DUP_DVENC_VALIDOS='||v_eligible);
 51    DBMS_OUTPUT.PUT_LINE('SEM_DUP_PARA_ANALISE='||v_without_dup);
 52    DBMS_OUTPUT.PUT_LINE('DUP_COM_XML_INVALIDO='||v_invalid_xml);
 53    DBMS_OUTPUT.PUT_LINE('STATUS=AGUARDANDO_ROTINA_NATIVA_DE_RECALCULO');
 54  END;
 55  /
ID_EXECUCAO=BASE_YYYYMMDD_FIN_DUP_01
NOTAS_SEM_FINANCEIRO_TOTAL=208
CANDIDATOS_DUP_DVENC_VALIDOS=207
SEM_DUP_PARA_ANALISE=1
DUP_COM_XML_INVALIDO=0
STATUS=AGUARDANDO_ROTINA_NATIVA_DE_RECALCULO


PL/SQL procedure successfully completed.

