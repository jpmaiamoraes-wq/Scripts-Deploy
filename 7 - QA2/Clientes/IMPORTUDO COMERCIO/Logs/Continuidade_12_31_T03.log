SQL> DECLARE
  2   v_tab NUMBER;v_id VARCHAR2(30):='RMD_RUPE_'||TO_CHAR(SYSTIMESTAMP,'YYYYMMDDHH24MISSFF3');
  3   v_b PLS_INTEGER;v_u PLS_INTEGER;
  4  BEGIN
  5   SELECT COUNT(*) INTO v_tab FROM ALL_TABLES WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA') AND TABLE_NAME='AD_SEGMENTACAOEMPRESAS';
  6   IF v_tab=0 THEN DBMS_OUTPUT.PUT_LINE('BLOCO_IGNORADO=AD_SEGMENTACAOEMPRESAS inexistente');RETURN;END IF;
  7   BEGIN
  8    EXECUTE IMMEDIATE q'[CREATE TABLE BKP_RMD_11_TGFEMP AS SELECT CAST(NULL AS VARCHAR2(30)) ID_EXECUCAO,
  9    CAST(NULL AS TIMESTAMP) DH_EXECUCAO,CAST(NULL AS VARCHAR2(128)) USUARIO_EXECUCAO,
 10    CAST(NULL AS VARCHAR2(30)) ROWID_ORIGINAL,E.RUPTURAEST RUPTURAEST_ANTES FROM TGFEMP E WHERE 1=0]';
 11   EXCEPTION WHEN OTHERS THEN
 12    IF SQLCODE <> -955 THEN RAISE; END IF;
 13   END;
 14   EXECUTE IMMEDIATE q'[INSERT INTO BKP_RMD_11_TGFEMP
 15   SELECT :id_execucao,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),
 16   ROWIDTOCHAR(E.ROWID),E.RUPTURAEST FROM TGFEMP E WHERE NVL(E.RUPTURAEST,'N')<>'S' AND EXISTS(
 17   SELECT 1 FROM AD_SEGMENTACAOEMPRESAS S JOIN TSIEMP T ON T.CGC=S.CGC WHERE S.SEGMENTACAO<>'S' AND T.CODEMP=E.CODEMP)]' USING v_id;
 18   v_b:=SQL%ROWCOUNT;
 19   EXECUTE IMMEDIATE q'[UPDATE TGFEMP E SET E.RUPTURAEST='S' WHERE NVL(E.RUPTURAEST,'N')<>'S' AND EXISTS(
 20   SELECT 1 FROM AD_SEGMENTACAOEMPRESAS S JOIN TSIEMP T ON T.CGC=S.CGC WHERE S.SEGMENTACAO<>'S' AND T.CODEMP=E.CODEMP)]';
 21   v_u:=SQL%ROWCOUNT;
 22   IF v_b<>v_u THEN RAISE_APPLICATION_ERROR(-20230,'Backup e atualizacao de empresas divergiram.');END IF;
 23   COMMIT;DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||v_id);DBMS_OUTPUT.PUT_LINE('EMPRESAS_ALTERADAS='||v_u);
 24  EXCEPTION WHEN OTHERS THEN ROLLBACK;RAISE;END;
