SQL> DECLARE v_id VARCHAR2(30):='RMD_TOPG_'||TO_CHAR(SYSTIMESTAMP,'YYYYMMDDHH24MISSFF3'); v_b PLS_INTEGER; v_u PLS_INTEGER;
  2  BEGIN
  3   INSERT INTO BKP_RMD_12_TGFTOP
  4   (ID_EXECUCAO,DH_EXECUCAO,USUARIO_EXECUCAO,ROWID_ORIGINAL,
  5    GOLSINAL_ANTES,GOLMPSINAL_ANTES,GOLDEV_ANTES,ANALISEGIRO_ANTES,
  6    ATUALULTIMAVEND_ANTES,ATUALULTIMACOMP_ANTES)
  7   SELECT v_id,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),ROWIDTOCHAR(ROWID),
  8          GOLSINAL,GOLMPSINAL,GOLDEV,ANALISEGIRO,ATUALULTIMAVEND,ATUALULTIMACOMP
  9   FROM TGFTOP WHERE 1=1;
 10   v_b:=SQL%ROWCOUNT;
 11   UPDATE TGFTOP SET GOLSINAL=CASE WHEN ATUALEST='B' AND TIPMOV='V' AND ATUALFIN=1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN -1 WHEN ATUALEST='E' AND TIPMOV='D' AND ATUALFIN=-1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN -1 WHEN ATUALEST='E' AND TIPMOV='C' AND ATUALFIN=-1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 1 WHEN ATUALEST='B' AND TIPMOV='E' AND ATUALFIN=1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 1 ELSE 0 END,
 12   GOLMPSINAL=CASE WHEN ATUALEST='B' AND TIPMOV='V' AND ATUALFIN=1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN -1 WHEN ATUALEST='E' AND TIPMOV='D' AND ATUALFIN=-1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN -1 WHEN ATUALEST='E' AND TIPMOV='C' AND ATUALFIN=-1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 1 WHEN ATUALEST='B' AND TIPMOV='E' AND ATUALFIN=1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 1 ELSE 0 END,
 13   GOLDEV=CASE WHEN TIPMOV IN ('D','E') AND ATUALEST IN ('E','B') AND CODMODDOC IN (55,59,65) AND (ATUALFIN<>0 OR TIPATUALFIN<>'P') THEN -1 ELSE 1 END,
 14   ANALISEGIRO=CASE WHEN TIPMOV='V' AND ATUALEST='B' AND ATUALFIN=1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN -1 WHEN TIPMOV='D' AND ATUALEST='E' AND ATUALFIN=-1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 1 ELSE 0 END,
 15   ATUALULTIMAVEND=CASE WHEN TIPMOV='V' AND ATUALEST='B' AND ATUALFIN=1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 'G' ELSE 'N' END,
 16   ATUALULTIMACOMP=CASE WHEN TIPMOV='C' AND ATUALEST='E' AND ATUALFIN=-1 AND TIPATUALFIN='I' AND CODMODDOC IN (55,59,65) THEN 'E' ELSE 'N' END WHERE 1=1;
 17   v_u:=SQL%ROWCOUNT;
 18   IF v_b<>v_u THEN RAISE_APPLICATION_ERROR(-20210,'Backup e atualizacao divergiram em Configurar_TOPs_Giro_GOL.'); END IF;
 19   COMMIT; DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||v_id); DBMS_OUTPUT.PUT_LINE('REGISTROS_ALTERADOS='||v_u);
 20   DBMS_OUTPUT.PUT_LINE('AVISO=Mapeamento de TOPs possui cobertura parcial aprovada.');
 21  EXCEPTION WHEN OTHERS THEN ROLLBACK; RAISE; END;
 22  /
