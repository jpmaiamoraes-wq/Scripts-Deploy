SQL> WITH DESTINOS(TO_CODE) AS (
  2    SELECT 'CD' FROM DUAL UNION ALL SELECT 'CX' FROM DUAL UNION ALL SELECT 'KG' FROM DUAL
  3    UNION ALL SELECT 'LT' FROM DUAL UNION ALL SELECT 'PC' FROM DUAL UNION ALL SELECT 'UN' FROM DUAL
  4    UNION ALL SELECT 'MT' FROM DUAL UNION ALL SELECT 'PT' FROM DUAL UNION ALL SELECT 'TN' FROM DUAL
  5    UNION ALL SELECT 'RL' FROM DUAL UNION ALL SELECT 'BL' FROM DUAL UNION ALL SELECT 'FR' FROM DUAL
  6    UNION ALL SELECT 'JG' FROM DUAL UNION ALL SELECT 'SC' FROM DUAL UNION ALL SELECT 'CJ' FROM DUAL
  7    UNION ALL SELECT 'FL' FROM DUAL UNION ALL SELECT 'DZ' FROM DUAL UNION ALL SELECT 'KT' FROM DUAL
  8    UNION ALL SELECT 'BD' FROM DUAL UNION ALL SELECT 'BG' FROM DUAL UNION ALL SELECT 'M2' FROM DUAL
  9    UNION ALL SELECT 'M3' FROM DUAL UNION ALL SELECT 'GR' FROM DUAL UNION ALL SELECT 'FD' FROM DUAL
 10    UNION ALL SELECT 'PAR' FROM DUAL
 11  ), CANONICOS AS (
 12    SELECT D.TO_CODE,V.DESCRVOL FROM DESTINOS D JOIN TGFVOL V ON V.CODVOL=D.TO_CODE
 13  ), CANDIDATOS AS (
 14    SELECT S.CODVOL FROM_CODE,D.TO_CODE,'CODIGO_SEM_PONTUACAO' MOTIVO
 15    FROM TGFVOL S JOIN CANONICOS D
 16      ON REGEXP_REPLACE(TRANSLATE(UPPER(S.CODVOL),
 17         'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC'),'[^A-Z]','')=D.TO_CODE
 18    WHERE S.CODVOL<>D.TO_CODE AND NOT REGEXP_LIKE(S.CODVOL,'[0-9]')
 19    UNION ALL
 20    SELECT S.CODVOL,D.TO_CODE,'DESCRICAO_EQUIVALENTE'
 21    FROM TGFVOL S JOIN CANONICOS D
 22      ON REGEXP_REPLACE(REGEXP_REPLACE(TRANSLATE(UPPER(TRIM(S.DESCRVOL)),
 23         'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC'),'[^A-Z]',''),'S$','')
 24       = REGEXP_REPLACE(REGEXP_REPLACE(TRANSLATE(UPPER(TRIM(D.DESCRVOL)),
 25         'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC'),'[^A-Z]',''),'S$','')
 26    WHERE S.CODVOL<>D.TO_CODE AND NOT REGEXP_LIKE(S.CODVOL,'[0-9]')
 27  )
 28  SELECT FROM_CODE,MAX(TO_CODE) TO_CODE,LISTAGG(MOTIVO,',') WITHIN GROUP(ORDER BY MOTIVO) MOTIVOS
 29  FROM CANDIDATOS
 30  GROUP BY FROM_CODE
 31  HAVING COUNT(DISTINCT TO_CODE)=1
 32  ORDER BY FROM_CODE;
