SQL> @@"/Users/spadarojr/Documents/Trabalho/Sankhya/Deploy Agent/Scripts-Deploy/7 - QA2/Revisao Master Deploy/31_Recompilar_Objetos_Invalidos.sql"
SQL> -- Recompila objetos invalidos apenas quando a sessao possui o privilegio necessario.
SQL> SET DEFINE OFF
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> SET SQLBLANKLINES ON
SQL> DECLARE
  2    v_schema VARCHAR2(128):=SYS_CONTEXT('USERENV','CURRENT_SCHEMA');
  3    v_usuario VARCHAR2(128):=SYS_CONTEXT('USERENV','SESSION_USER');
  4    v_antes NUMBER;
  5    v_depois NUMBER;
  6    v_priv NUMBER;
  7  BEGIN
  8    SELECT COUNT(*) INTO v_antes FROM ALL_OBJECTS
  9    WHERE OWNER=v_schema AND STATUS='INVALID';
 10  
 11    SELECT COUNT(*) INTO v_priv FROM SESSION_PRIVS
 12    WHERE PRIVILEGE='ALTER ANY PROCEDURE';
 13  
 14    IF v_antes=0 THEN
 15      DBMS_OUTPUT.PUT_LINE('STATUS=CONCLUIDO; OBJETOS_INVALIDOS=0');
 16    ELSIF v_schema<>v_usuario AND v_priv=0 THEN
 17      DBMS_OUTPUT.PUT_LINE('STATUS=IGNORADO_SEM_PRIVILEGIO; OBJETOS_INVALIDOS='||v_antes
 18        ||'; USUARIO='||v_usuario||'; SCHEMA='||v_schema||'; PRIVILEGIO_NECESSARIO=ALTER ANY PROCEDURE');
 19    ELSE
 20      DBMS_UTILITY.COMPILE_SCHEMA(SCHEMA=>v_schema,COMPILE_ALL=>FALSE);
 21      SELECT COUNT(*) INTO v_depois FROM ALL_OBJECTS
 22      WHERE OWNER=v_schema AND STATUS='INVALID';
 23      DBMS_OUTPUT.PUT_LINE('STATUS=CONCLUIDO; INVALIDOS_ANTES='||v_antes||'; INVALIDOS_DEPOIS='||v_depois);
 24    END IF;
 25  END;
 26  /
STATUS=CONCLUIDO; OBJETOS_INVALIDOS=0


