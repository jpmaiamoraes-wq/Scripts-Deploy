SQL> DECLARE
  2   v_s1 VARCHAR2(8);v_s2 VARCHAR2(8);v_total NUMBER:=0;v_descr NUMBER:=0;
  3   PROCEDURE restaura IS
  4   BEGIN
  5    IF v_s1='ENABLED' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER TRG_INC_UPD_TGFITE ENABLE';END IF;
  6    IF v_s2='ENABLED' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER TRG_UPT_TGFITE ENABLE';END IF;
  7   END;
  8   PROCEDURE salva(p_tab VARCHAR2,p_col VARCHAR2) IS v_sql CLOB;BEGIN
  9    v_sql:='INSERT INTO BKP_RMD_UNID_'||p_tab||' SELECT :1,SYSTIMESTAMP,SYS_CONTEXT(''USERENV'',''SESSION_USER''),ROWIDTOCHAR(T.ROWID),T.* FROM '||p_tab||' T WHERE EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES M WHERE M.FROM_CODE=T.'||p_col||')';
 10    EXECUTE IMMEDIATE v_sql USING :RMD_ID_UNID;v_total:=v_total+SQL%ROWCOUNT;
 11   END;
 12  BEGIN
 13   SELECT STATUS INTO v_s1 FROM ALL_TRIGGERS WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA') AND TRIGGER_NAME='TRG_INC_UPD_TGFITE';
 14   SELECT STATUS INTO v_s2 FROM ALL_TRIGGERS WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA') AND TRIGGER_NAME='TRG_UPT_TGFITE';
 15   salva('TGFPRO','CODVOL');salva('TGFITE','CODVOL');salva('TGFPAP','UNIDADEPARC');
 16   salva('TGFCOI2','CODVOL');salva('TGFGIR1','CODVOL');salva('TGFVOA','CODVOL');salva('TGFVOL','CODVOL');
 17   INSERT INTO BKP_RMD_UNID_TGFVOL
 18   SELECT :RMD_ID_UNID,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),ROWIDTOCHAR(T.ROWID),T.*
 19   FROM TGFVOL T
 20   WHERE T.DESCRVOL<>UPPER(T.DESCRVOL)
 21     AND NOT EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES M WHERE M.FROM_CODE=T.CODVOL);
 22   v_total:=v_total+SQL%ROWCOUNT;
 23   IF v_s1='ENABLED' THEN
 24    INSERT INTO RMD_CONTROLE_OBJETOS(ID_MASTER,ID_EXECUCAO,DH_REGISTRO,USUARIO_EXECUCAO,OBJECT_TYPE,OBJECT_NAME,STATUS_ANTES)
 25    VALUES(:RMD_ID_MASTER,:RMD_ID_UNID,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),'TRIGGER','TRG_INC_UPD_TGFITE',v_s1);
 26    EXECUTE IMMEDIATE 'ALTER TRIGGER TRG_INC_UPD_TGFITE DISABLE';
 27   END IF;
 28   IF v_s2='ENABLED' THEN
 29    INSERT INTO RMD_CONTROLE_OBJETOS(ID_MASTER,ID_EXECUCAO,DH_REGISTRO,USUARIO_EXECUCAO,OBJECT_TYPE,OBJECT_NAME,STATUS_ANTES)
 30    VALUES(:RMD_ID_MASTER,:RMD_ID_UNID,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),'TRIGGER','TRG_UPT_TGFITE',v_s2);
 31    EXECUTE IMMEDIATE 'ALTER TRIGGER TRG_UPT_TGFITE DISABLE';
 32   END IF;
 33   UPDATE TGFPRO P SET CODVOL=(SELECT TO_CODE FROM RMD_MAP_UNIDADES WHERE FROM_CODE=P.CODVOL) WHERE EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES WHERE FROM_CODE=P.CODVOL);
 34   UPDATE TGFITE I SET CODVOL=(SELECT TO_CODE FROM RMD_MAP_UNIDADES WHERE FROM_CODE=I.CODVOL) WHERE EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES WHERE FROM_CODE=I.CODVOL);
 35   UPDATE TGFPAP P SET UNIDADEPARC=(SELECT TO_CODE FROM RMD_MAP_UNIDADES WHERE FROM_CODE=P.UNIDADEPARC) WHERE EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES WHERE FROM_CODE=P.UNIDADEPARC);
 36   UPDATE TGFCOI2 C SET CODVOL=(SELECT TO_CODE FROM RMD_MAP_UNIDADES WHERE FROM_CODE=C.CODVOL) WHERE EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES WHERE FROM_CODE=C.CODVOL);
 37   UPDATE TGFGIR1 G SET CODVOL=(SELECT TO_CODE FROM RMD_MAP_UNIDADES WHERE FROM_CODE=G.CODVOL) WHERE EXISTS(SELECT 1 FROM RMD_MAP_UNIDADES WHERE FROM_CODE=G.CODVOL);
 38   DELETE FROM TGFVOA WHERE CODVOL IN(SELECT FROM_CODE FROM RMD_MAP_UNIDADES);
 39   DELETE FROM TGFVOL WHERE CODVOL IN(SELECT FROM_CODE FROM RMD_MAP_UNIDADES);
 40   UPDATE TGFVOL SET DESCRVOL=UPPER(DESCRVOL) WHERE DESCRVOL<>UPPER(DESCRVOL);
 41   v_descr:=SQL%ROWCOUNT;
 42   restaura;
 43   UPDATE RMD_CONTROLE_OBJETOS SET STATUS_DEPOIS='ENABLED',DH_REABILITACAO=SYSTIMESTAMP
 44    WHERE ID_MASTER=:RMD_ID_MASTER AND ID_EXECUCAO=:RMD_ID_UNID
 45      AND OBJECT_TYPE='TRIGGER' AND STATUS_ANTES='ENABLED';
 46   COMMIT;
 47   DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||:RMD_ID_UNID);DBMS_OUTPUT.PUT_LINE('REGISTROS_BACKUP='||v_total);
 48   DBMS_OUTPUT.PUT_LINE('DESCRICOES_TGFVOL_MAIUSCULAS='||v_descr);
 49  EXCEPTION WHEN OTHERS THEN
 50   BEGIN restaura;EXCEPTION WHEN OTHERS THEN NULL;END;
 51   ROLLBACK;RAISE;
 52  END;
 53  /
