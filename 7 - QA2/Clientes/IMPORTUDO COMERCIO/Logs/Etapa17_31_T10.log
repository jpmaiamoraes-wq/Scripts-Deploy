SQL> MERGE INTO RMD_MAP_UNIDADES T
  2  USING (
  3    WITH DESTINOS AS (
  4      SELECT DISTINCT M.TO_CODE,C.DESCRVOL
  5      FROM RMD_MAP_UNIDADES M
  6      JOIN TGFVOL C ON C.CODVOL=M.TO_CODE
  7    ), CANDIDATOS AS (
  8      SELECT S.CODVOL FROM_CODE,D.TO_CODE
  9      FROM TGFVOL S
 10      JOIN DESTINOS D
 11        ON REGEXP_REPLACE(
 12             TRANSLATE(UPPER(S.CODVOL),'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC'),
 13             '[^A-Z]','')=D.TO_CODE
 14      WHERE S.CODVOL<>D.TO_CODE
 15        AND NOT REGEXP_LIKE(S.CODVOL,'[0-9]')
 16      UNION ALL
 17      SELECT S.CODVOL,D.TO_CODE
 18      FROM TGFVOL S
 19      JOIN DESTINOS D
 20        ON REGEXP_REPLACE(REGEXP_REPLACE(
 21             TRANSLATE(UPPER(TRIM(S.DESCRVOL)),'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC'),
 22             '[^A-Z]',''),'S$','')
 23         = REGEXP_REPLACE(REGEXP_REPLACE(
 24             TRANSLATE(UPPER(TRIM(D.DESCRVOL)),'ÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ','AAAAAEEEEIIIIOOOOOUUUUC'),
 25             '[^A-Z]',''),'S$','')
 26      WHERE S.CODVOL<>D.TO_CODE
 27        AND NOT REGEXP_LIKE(S.CODVOL,'[0-9]')
 28    )
 29    SELECT FROM_CODE,MAX(TO_CODE) TO_CODE
 30    FROM CANDIDATOS
 31    GROUP BY FROM_CODE
 32    HAVING COUNT(DISTINCT TO_CODE)=1
 33  ) S
 34  ON (T.FROM_CODE=S.FROM_CODE)
 35  WHEN MATCHED THEN UPDATE SET T.TO_CODE=S.TO_CODE
 36  WHEN NOT MATCHED THEN INSERT(FROM_CODE,TO_CODE) VALUES(S.FROM_CODE,S.TO_CODE);

