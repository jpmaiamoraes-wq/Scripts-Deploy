SQL> DECLARE
  2   v_id VARCHAR2(30):='RMD_ITEM_'||TO_CHAR(SYSTIMESTAMP,'YYYYMMDDHH24MISSFF3');
  3   v_status VARCHAR2(8); v_b PLS_INTEGER; v_u PLS_INTEGER;
  4   PROCEDURE restaura_trigger IS BEGIN
  5     IF v_status='ENABLED' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER TRG_UPT_TGFITE ENABLE'; END IF;
  6   EXCEPTION WHEN OTHERS THEN DBMS_OUTPUT.PUT_LINE('ERRO_AO_RESTAURAR_TRIGGER='||SQLERRM); RAISE; END;
  7  BEGIN
  8   SELECT STATUS INTO v_status FROM ALL_TRIGGERS
  9    WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA') AND TRIGGER_NAME='TRG_UPT_TGFITE';
 10   INSERT INTO BKP_RMD_08_TGFITE SELECT v_id,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),
 11          ROWIDTOCHAR(ROWID),STATUSNOTA FROM TGFITE I
 12    WHERE NVL(STATUSNOTA,'?')<>'L' AND EXISTS(SELECT 1 FROM TTKNOT N WHERE N.NUNOTA=I.NUNOTA);
 13   v_b:=SQL%ROWCOUNT;
 14   IF v_status='ENABLED' THEN
 15    INSERT INTO RMD_CONTROLE_OBJETOS
 16     (ID_MASTER,ID_EXECUCAO,DH_REGISTRO,USUARIO_EXECUCAO,OBJECT_TYPE,OBJECT_NAME,STATUS_ANTES)
 17    VALUES(:RMD_ID_MASTER,v_id,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),
 18           'TRIGGER','TRG_UPT_TGFITE',v_status);
 19    EXECUTE IMMEDIATE 'ALTER TRIGGER TRG_UPT_TGFITE DISABLE';
 20   END IF;
 21   UPDATE TGFITE I SET STATUSNOTA='L'
 22    WHERE NVL(STATUSNOTA,'?')<>'L' AND EXISTS(SELECT 1 FROM TTKNOT N WHERE N.NUNOTA=I.NUNOTA);
 23   v_u:=SQL%ROWCOUNT;
 24   restaura_trigger;
 25   UPDATE RMD_CONTROLE_OBJETOS SET STATUS_DEPOIS='ENABLED',DH_REABILITACAO=SYSTIMESTAMP
 26    WHERE ID_MASTER=:RMD_ID_MASTER AND ID_EXECUCAO=v_id
 27      AND OBJECT_TYPE='TRIGGER' AND OBJECT_NAME='TRG_UPT_TGFITE';
 28   IF v_b<>v_u THEN RAISE_APPLICATION_ERROR(-20220,'Backup e atualizacao de itens divergiram.'); END IF;
 29   COMMIT; DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||v_id); DBMS_OUTPUT.PUT_LINE('ITENS_ALTERADOS='||v_u);
 30  EXCEPTION WHEN OTHERS THEN
 31   BEGIN restaura_trigger; EXCEPTION WHEN OTHERS THEN NULL; END;
 32   ROLLBACK; RAISE;
 33  END;
 34  /
