SQL> DECLARE v_id VARCHAR2(30):='RMD_PROT_'||TO_CHAR(SYSTIMESTAMP,'YYYYMMDDHH24MISSFF3'); v_b PLS_INTEGER; v_u PLS_INTEGER;
