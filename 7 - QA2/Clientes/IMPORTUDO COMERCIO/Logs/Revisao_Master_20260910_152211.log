  6   v_b:=SQL%ROWCOUNT;
  7   UPDATE TGFCAB SET NUMPROTOC=CASE WHEN NUMPROTOC IS NULL AND EXISTS (SELECT 1 FROM TGFTOP T WHERE T.CODTIPOPER=TGFCAB.CODTIPOPER AND T.DHALTER=TGFCAB.DHTIPOPER AND T.CODMODDOC=55) THEN '0' ELSE NUMPROTOC END,
  8   NUMPROTOCCTE=CASE WHEN NUMPROTOCCTE IS NULL AND EXISTS (SELECT 1 FROM TGFTOP T WHERE T.CODTIPOPER=TGFCAB.CODTIPOPER AND T.DHALTER=TGFCAB.DHTIPOPER AND T.CODMODDOC=57) THEN '0' ELSE NUMPROTOCCTE END WHERE EXISTS (SELECT 1 FROM TTKNOT N WHERE N.NUNOTA=TGFCAB.NUNOTA)
  9   AND ((NUMPROTOC IS NULL AND EXISTS (SELECT 1 FROM TGFTOP T WHERE T.CODTIPOPER=TGFCAB.CODTIPOPER AND T.DHALTER=TGFCAB.DHTIPOPER AND T.CODMODDOC=55))
