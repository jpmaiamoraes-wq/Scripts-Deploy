SQL> -- Etapa 32B - Inclusao controlada de financeiros a partir do XML
SQL> --
SQL> -- Executa somente com CONFIRMA_INSERCAO = SIM.
SQL> -- Regras consolidadas: TIPRECDESP textual (I/R/D/P) e convertido para RECDESP numerico;
SQL> -- CODBCO nulo recebe 0 e TIPJURO usa 1 quando a TGFTPV retorna o marcador textual I.
SQL> -- O mapa 32A deve estar presente e conter apenas linhas APTO_PARA_VALIDACAO_FINAL.
SQL> -- O INSERT reproduz os campos e padroes observados na rotina nativa REFAZER FINANCEIRO.
SQL> 
SQL> SET DEFINE ON
SQL> 
SQL> -- Parametros obrigatorios: devem ser os mesmos usados no script 32A.
SQL> -- Mantenha CONFIRMA_INSERCAO=NAO para o mapa/preflight; altere para SIM
SQL> -- somente depois da revisao final do mapa.
SQL> DEFINE ID_EXECUCAO = 'IMPORTUDO_20260910_FDUP_06'
SQL> DEFINE TBL_BASE = 'BKP_RMD_FDUP_IMPORTUDO_06'
SQL> DEFINE TBL_PPG = 'BKP_RMD_FDUP_IMPORTUDO_06_PPG'
SQL> DEFINE TBL_INS = 'BKP_RMD_FDUP_IMPORTUDO_06_INS'
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> SET SQLBLANKLINES ON
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> 
SQL> DEFINE CONFIRMA_INSERCAO = 'SIM'
SQL> 
SQL> PROMPT === CARD 09 - INSERT CONTROLADO TGFFIN ===
=== CARD 09 - INSERT CONTROLADO TGFFIN ===
SQL> 
SQL> DECLARE
  2    v_qtd NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO v_qtd FROM ALL_TABLES WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA') AND TABLE_NAME='&TBL_INS';
  5    IF v_qtd=0 THEN
  6      EXECUTE IMMEDIATE q'[CREATE TABLE &TBL_INS (ID_EXECUCAO VARCHAR2(40) NOT NULL, DH_EXECUCAO TIMESTAMP NOT NULL, NUNOTA NUMBER NOT NULL, NUFIN NUMBER NOT NULL, VLRDESDOB NUMBER, DTVENC DATE)]';
  7    END IF;
  8  END;
