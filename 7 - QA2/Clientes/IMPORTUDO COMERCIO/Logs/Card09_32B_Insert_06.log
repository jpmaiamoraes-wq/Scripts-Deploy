SQL> DECLARE
  2    v_confirm VARCHAR2(3) := UPPER('&&CONFIRMA_INSERCAO');
  3    v_qtd NUMBER;
  4    v_distinct NUMBER;
  5    v_existentes NUMBER;
  6    v_pendentes NUMBER;
  7    v_tgfnum_rows NUMBER;
  8    v_ultcod TGFNUM.ULTCOD%TYPE;
  9    v_nufin TGFFIN.NUFIN%TYPE;
 10    v_vldup TGFFIN.VLRDESDOB%TYPE;
 11    v_dvenc TGFFIN.DTVENC%TYPE;
 12    v_codctabcoint TSICTA.CODCTABCOINT%TYPE;
 13    v_inseridos NUMBER := 0;
 14  BEGIN
 15    SELECT COUNT(*) INTO v_qtd FROM &TBL_PPG WHERE ID_EXECUCAO='&ID_EXECUCAO' AND STATUS_MAPA <> 'APTO_PARA_VALIDACAO_FINAL';
 16    IF v_qtd > 0 THEN
 17      RAISE_APPLICATION_ERROR(-20323,'Existem linhas do mapa sem status APTO_PARA_VALIDACAO_FINAL.');
 18    END IF;
 19    SELECT COUNT(*), COUNT(DISTINCT NUNOTA) INTO v_qtd, v_distinct FROM &TBL_PPG WHERE ID_EXECUCAO='&ID_EXECUCAO';
 20    IF v_qtd = 0 OR v_qtd <> v_distinct THEN
 21      RAISE_APPLICATION_ERROR(-20324,'Mapa vazio ou com mais de uma linha por NUNOTA; revisar parcelas antes do INSERT.');
 22    END IF;
 23    SELECT COUNT(DISTINCT M.NUNOTA) INTO v_existentes
 24      FROM TGFFIN F
 25      JOIN &TBL_PPG M ON M.NUNOTA=F.NUNOTA AND M.ID_EXECUCAO='&ID_EXECUCAO';
 26    SELECT COUNT(*) INTO v_pendentes
 27      FROM &TBL_PPG M
 28     WHERE M.ID_EXECUCAO='&ID_EXECUCAO'
 29       AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA=M.NUNOTA);
 30    DBMS_OUTPUT.PUT_LINE('JA_EXISTIAM_TGFFIN='||v_existentes);
 31    DBMS_OUTPUT.PUT_LINE('PENDENTES_PARA_INSERCAO='||v_pendentes);
 32    IF v_pendentes = 0 THEN
 33      DBMS_OUTPUT.PUT_LINE('STATUS=SEM_PENDENTES_PARA_INSERCAO');
 34      RETURN;
 35    END IF;
 36    SELECT COUNT(*) INTO v_qtd
 37      FROM &TBL_PPG M
 38      JOIN TGFCAB C ON C.NUNOTA=M.NUNOTA
 39      LEFT JOIN TGFTPV V
 40        ON V.CODTIPVENDA=M.CODTIPVENDA
 41       AND V.DHALTER=C.DHTIPVENDA
 42     WHERE M.ID_EXECUCAO='&ID_EXECUCAO'
 43       AND V.CODTIPVENDA IS NULL;
 44    IF v_qtd > 0 THEN
 45      RAISE_APPLICATION_ERROR(-20329,'Uma ou mais notas nao possuem a versao exata da TGFTPV usada no cabecalho.');
 46    END IF;
 47    SELECT COUNT(*) INTO v_qtd
 48      FROM &TBL_PPG
 49     WHERE ID_EXECUCAO='&ID_EXECUCAO'
 50       AND NOT REGEXP_LIKE(TRIM(VDUP_XML),'^[0-9]+([.][0-9]+)?$');
 51    IF v_qtd > 0 THEN
 52      RAISE_APPLICATION_ERROR(-20330,'Existe vDup XML nao numerico no mapa.');
 53    END IF;
 54    SELECT COUNT(*) INTO v_qtd
 55      FROM &TBL_PPG M
 56     WHERE M.ID_EXECUCAO='&ID_EXECUCAO'
 57       AND NOT EXISTS (SELECT 1 FROM TGFTIT T WHERE T.CODTIPTIT=M.CODTIPTITPAD);
 58    IF v_qtd > 0 THEN
 59      RAISE_APPLICATION_ERROR(-20331,'Existe CODTIPTITPAD sem correspondente na TGFTIT.');
 60    END IF;
 61    SELECT COUNT(*) INTO v_tgfnum_rows FROM TGFNUM WHERE ARQUIVO='TGFFIN';
 62    DBMS_OUTPUT.PUT_LINE('TGFNUM_TGFFIN_ROWS='||v_tgfnum_rows);
 63    IF v_tgfnum_rows <> 1 THEN
 64      FOR t IN (SELECT ARQUIVO, ULTCOD FROM TGFNUM WHERE ARQUIVO='TGFFIN' ORDER BY ULTCOD) LOOP
 65        DBMS_OUTPUT.PUT_LINE('TGFNUM_ROW ARQUIVO='||t.ARQUIVO||' ULTCOD='||t.ULTCOD);
 66      END LOOP;
 67      DBMS_OUTPUT.PUT_LINE('DIAGNOSTICO_TGFNUM; nenhuma alteração realizada.');
 68      ROLLBACK;
 69      RETURN;
 70    END IF;
 71    IF v_confirm <> 'SIM' THEN
 72      DBMS_OUTPUT.PUT_LINE('STATUS=NAO_EXECUTADO; altere CONFIRMA_INSERCAO para SIM após revisar o mapa.');
 73      RETURN;
 74    END IF;
 75    DBMS_OUTPUT.PUT_LINE('ANTES_LOCK_TGFNUM');
 76    SELECT ULTCOD INTO v_ultcod FROM TGFNUM WHERE ARQUIVO='TGFFIN' FOR UPDATE WAIT 5;
 77    DBMS_OUTPUT.PUT_LINE('APOS_LOCK_TGFNUM ULTCOD='||v_ultcod);
 78    SELECT COUNT(*) INTO v_qtd FROM &TBL_INS WHERE ID_EXECUCAO='&ID_EXECUCAO';
 79    IF v_qtd > 0 THEN
 80      RAISE_APPLICATION_ERROR(-20327,'Ja existem inclusoes auditadas para este ID_EXECUCAO.');
 81    END IF;
 82    FOR r IN (
 83      SELECT M.*, C.TIPMOV, C.DHTIPVENDA, V.TIPJURO
 84        FROM &TBL_PPG M
 85        JOIN TGFCAB C ON C.NUNOTA=M.NUNOTA
 86        LEFT JOIN TGFTPV V ON V.CODTIPVENDA=M.CODTIPVENDA AND V.DHALTER=C.DHTIPVENDA
 87       WHERE M.ID_EXECUCAO='&ID_EXECUCAO'
 88         AND M.STATUS_MAPA='APTO_PARA_VALIDACAO_FINAL'
 89         AND NOT EXISTS (SELECT 1 FROM TGFFIN F WHERE F.NUNOTA=M.NUNOTA)
 90       ORDER BY M.NUNOTA, M.SEQ_PPG
 91    ) LOOP
 92      v_nufin := v_ultcod + 1;
 93      DBMS_OUTPUT.PUT_LINE('PROCESSANDO NUNOTA='||r.NUNOTA||' NUFIN='||v_nufin||' VDUP='||r.VDUP_XML||' DVENC='||r.DVENC_XML||' NDUP='||NVL(r.NDUP_XML,'<NULL>'));
 94      BEGIN
 95        v_vldup := TO_NUMBER(TRIM(r.VDUP_XML),
 96                             '999999999999999999D99999999',
 97                             'NLS_NUMERIC_CHARACTERS=''.,''');
 98        v_dvenc := TO_DATE(TRIM(r.DVENC_XML),'YYYY-MM-DD');
 99        IF r.CODCTABCOINT IS NOT NULL THEN
100          v_codctabcoint := r.CODCTABCOINT;
101        ELSE
102          SELECT MIN(A.CODCTABCOINT) INTO v_codctabcoint FROM TSICTA A
103           WHERE A.ATIVA='S' AND A.CODEMP=r.CODEMP;
104        END IF;
105        IF v_codctabcoint IS NULL THEN
106          RAISE_APPLICATION_ERROR(-20332,'Nenhuma conta bancaria ativa para CODEMP='||r.CODEMP||'.');
107        END IF;
108        DBMS_OUTPUT.PUT_LINE('CONTA_ATIVA_CODEMP='||r.CODEMP||' CODCTABCOINT='||v_codctabcoint);
