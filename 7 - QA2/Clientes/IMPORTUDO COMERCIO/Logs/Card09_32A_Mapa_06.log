SQL> @"/Users/spadarojr/Documents/Trabalho/Sankhya/Deploy Agent/Scripts-Deploy/7 - QA2/Clientes/IMPORTUDO COMERCIO/Artefatos_Revisao/Scripts/32A_Card09_Mapear_IMPORTUDO_06.sql"
SQL> -- Etapa 32A - Mapeamento para inclusao controlada de financeiros
SQL> --
SQL> -- Este arquivo ainda nao insere TGFFIN. Ele materializa, por nota e por
SQL> -- registro da TGFPPG, os valores necessarios para a futura inclusao direta.
SQL> -- Somente linhas com status APTO podem ser encaminhadas ao INSERT.
SQL> 
SQL> SET DEFINE ON
SQL> 
SQL> -- Parametros obrigatorios: altere os tres valores declarados antes de executar.
SQL> DEFINE ID_EXECUCAO = 'IMPORTUDO_20260910_FDUP_06'
SQL> DEFINE TBL_BASE = 'BKP_RMD_FDUP_IMPORTUDO_06'
SQL> DEFINE TBL_PPG = 'BKP_RMD_FDUP_IMPORTUDO_06_PPG'
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> SET SQLBLANKLINES ON
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> 
SQL> PROMPT === CARD 09 - MAPA PARA INSERT DIRETO TGFFIN ===
=== CARD 09 - MAPA PARA INSERT DIRETO TGFFIN ===
SQL> 
SQL> DECLARE
  2    v_qtd NUMBER;
  3  BEGIN
  4    SELECT COUNT(*) INTO v_qtd
  5      FROM ALL_TABLES
  6     WHERE OWNER = SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
  7       AND TABLE_NAME = '&TBL_PPG';
  8    IF v_qtd > 0 THEN
  9      RAISE_APPLICATION_ERROR(-20322,
 10        'Mapa &TBL_PPG ja existe. Gere novo ID antes de repetir.');
 11    END IF;
 12  
 13    EXECUTE IMMEDIATE q'[
 14      CREATE TABLE &TBL_PPG AS
 15      WITH C AS (
 16        SELECT B.ID_EXECUCAO, B.DH_EXECUCAO, B.USUARIO_EXECUCAO,
 17               B.NUNOTA, B.CODEMP, B.NUMNOTA, B.SERIENOTA, B.DTNEG,
 18               B.CODPARC, B.CODTIPOPER, B.DESCROPER,
 19               C.CODTIPVENDA, C.DHTIPOPER, C.DTENTSAI, C.DTMOV,
 20               C.CODVEND, C.CODNAT AS CODNAT_CAB,
 21               C.CODCENCUS AS CODCENCUS_CAB, C.CODPROJ AS CODPROJ_CAB,
 22               C.RATEADO AS RATEADO_CAB,
 23               B.VDUP_XML, B.DVENC_XML, B.NDUP_XML
 24          FROM &TBL_BASE B
 25          JOIN TGFCAB C ON C.NUNOTA = B.NUNOTA
 26         WHERE B.ID_EXECUCAO = '&ID_EXECUCAO'
 27      ), P AS (
 28        SELECT C.*,
 29               P.TIPOEMP, P.CODEMP AS CODEMP_PPG, P.TIPOPAR,
 30               P.CODPARC AS CODPARC_PPG, P.SEQUENCIA AS SEQ_PPG,
 31               P.PRAZO, P.CODTIPTITPAD, P.CODBCOPAD, P.CODCTABCOINT,
 32               P.CODCENCUSPAD, P.CODNATPAD, P.CODPROJPAD,
 33               P.TIPRECDESP, P.TIPOFIN, P.PERCENTUAL,
 34               COUNT(P.CODTIPVENDA) OVER (PARTITION BY C.NUNOTA) AS QTD_PPG_ENCONTRADAS,
 35               COUNT(P.CODTIPVENDA) OVER (PARTITION BY C.NUNOTA, P.SEQUENCIA) AS QTD_PPG_MESMA_SEQ,
 36               ROW_NUMBER() OVER (
 37                 PARTITION BY C.NUNOTA
 38                 ORDER BY P.SEQUENCIA, P.PRAZO, P.TIPOEMP,
 39                          P.CODEMP, P.TIPOPAR, P.CODPARC
 40               ) AS RN_PPG
 41          FROM C
 42          LEFT JOIN TGFPPG P ON P.CODTIPVENDA = C.CODTIPVENDA
 43      )
 44      SELECT P.ID_EXECUCAO, P.DH_EXECUCAO, P.USUARIO_EXECUCAO,
 45             P.NUNOTA, P.NUMNOTA, P.SERIENOTA, P.CODEMP, P.CODPARC,
 46             P.CODTIPOPER, P.DESCROPER, P.CODTIPVENDA, P.DHTIPOPER,
 47             P.DTNEG, P.DTENTSAI, P.DTMOV, P.CODVEND,
 48             P.CODNAT_CAB, P.CODCENCUS_CAB, P.CODPROJ_CAB, P.RATEADO_CAB,
 49             P.TIPOEMP, P.CODEMP_PPG, P.TIPOPAR, P.CODPARC_PPG,
 50             P.SEQ_PPG, P.PRAZO, P.CODTIPTITPAD, P.CODBCOPAD,
 51             P.CODCTABCOINT, P.CODCENCUSPAD, P.CODNATPAD, P.CODPROJPAD,
 52             P.TIPRECDESP, P.TIPOFIN, P.PERCENTUAL,
 53             P.VDUP_XML, P.DVENC_XML, P.NDUP_XML,
 54             (SELECT MAX(N.ULTCOD) FROM TGFNUM N WHERE N.ARQUIVO = 'TGFFIN')
 55               AS ULTCOD_TGFNUM_ATUAL,
 56             CASE
 57               WHEN P.QTD_PPG_ENCONTRADAS = 0 THEN 'SEM_TGFPPG'
 58               WHEN P.QTD_PPG_MESMA_SEQ > 1 THEN 'REVISAR_DUPLICIDADE_TGFPPG'
 59               WHEN P.VDUP_XML IS NULL THEN 'SEM_VDUP_XML'
 60               WHEN NOT REGEXP_LIKE(P.DVENC_XML, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
 61                 THEN 'DVENC_XML_INVALIDO'
 62               WHEN P.CODTIPTITPAD IS NULL THEN 'SEM_CODTIPTITPAD'
 63               WHEN (SELECT COUNT(*) FROM TGFNUM N WHERE N.ARQUIVO = 'TGFFIN') <> 1
 64                 THEN 'REVISAR_TGFNUM'
 65               ELSE 'APTO_PARA_VALIDACAO_FINAL'
 66             END AS STATUS_MAPA,
 67             CASE
 68               WHEN P.QTD_PPG_ENCONTRADAS = 0 THEN 'Nao foi encontrada condicao em TGFPPG.'
 69               WHEN P.QTD_PPG_MESMA_SEQ > 1 THEN 'Mais de uma TGFPPG para a mesma sequencia; aplicar regra de precedencia.'
 70               WHEN P.DVENC_XML IS NULL THEN 'Vencimento deve ser obtido do XML.'
 71               WHEN P.CODTIPTITPAD IS NULL THEN 'Tipo de titulo ausente na condicao de pagamento.'
 72               ELSE 'Revisar valores e somente depois gerar o INSERT.'
 73             END AS OBSERVACAO
 74        FROM P
 75    ]';
 76  END;
 77  /

PL/SQL procedure successfully completed.

