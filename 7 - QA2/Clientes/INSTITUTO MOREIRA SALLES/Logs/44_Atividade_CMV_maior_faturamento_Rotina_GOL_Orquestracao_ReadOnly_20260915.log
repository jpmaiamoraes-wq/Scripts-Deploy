1|PROCEDURE PFCM_CONSOLIDACAO AS
2|   P_HOJE DATE;
3|   P_DIA INT;
4|   P_DIASRETROAGIR INT;
5|BEGIN   
6|   P_DIASRETROAGIR := 372;
7|   P_HOJE := TRUNC(SYSDATE);
8|   P_DIA := 0;
9|   
10|   DELETE FROM TFCM_CONSOLIDACAO;
11|   
12|   WHILE P_DIA <= P_DIASRETROAGIR
13|   LOOP
14|      BEGIN
15|         INSERT INTO TFCM_CONSOLIDACAO( CODNAT,CODCENCUS,CODPROJ,NUFIN,DTNEG,DTVENC,VLRDESDOB,VLRLIQUIDO,DTREF) 
16|		    SELECT  
17|  FIN.CODNAT AS CODNAT,
18|  FIN.CODCENCUS AS CODCENCUS,
19|  FIN.CODPROJ AS CODPROJ,
20|  FIN.NUFIN,
21|  FIN.DTNEG,
22|  FIN.DTVENC,
23|  (FIN.VLRDESDOB * FIN.RECDESP) AS VLRDESDOB,
24|  (FIN.VLRLIQUIDO * FIN.RECDESP) AS VLRLIQUIDO,
25|  FIN.DTNEG AS DTREF
26|FROM VGFFIN FIN
27|WHERE
28|TRUNC(FIN.DTNEG) BETWEEN P_HOJE AND P_HOJE
29|AND FIN.RECDESP <> 0
30|AND NOT (FIN.PROVISAO = 'S' AND FIN.DHBAIXA IS NOT NULL AND FIN.ORIGEM='E')
31|AND NOT EXISTS ( SELECT 1 FROM TGFRAT RAT
32|                 WHERE RAT.ORIGEM = 'F' AND RAT.NUFIN = FIN.NUFIN)
33|AND NOT EXISTS ( SELECT 1 FROM TGFRAT RAT
34|                 WHERE RAT.ORIGEM = 'E' AND RAT.NUFIN = FIN.NUNOTA)
35|/*NATUREZA ESPECIAL*/
36|/*ANTECIPACAO*/ 
37|UNION ALL
38|
39|SELECT
40|  RAT.CODNAT AS CODNAT,
41|  RAT.CODCENCUS AS CODCENCUS,
42|  RAT.CODPROJ AS CODPROJ,
43|  FIN.NUFIN,
44|  FIN.DTNEG,
45|  FIN.DTVENC AS DTVENC,
46|  /* TEMRATADVALOR CASE WHEN FIN.VLRDESDOB = 0 THEN NVL(RAT.AD_VALOR,0) ELSE TEMRATADVALOR */ (FIN.VLRDESDOB * RAT.PERCRATEIO / 100) /* TEMRATADVALOR END TEMRATADVALOR */ * FIN.RECDESP AS VLRDESDOB,
47|  /* TEMRATADVALOR CASE WHEN FIN.VLRLIQUIDO = 0 THEN NVL(RAT.AD_VALOR,0) ELSE TEMRATADVALOR */ (FIN.VLRLIQUIDO * RAT.PERCRATEIO / 100) /* TEMRATADVALOR END TEMRATADVALOR */ * FIN.RECDESP AS VLRLIQUIDO,
48|  FIN.DTNEG AS DTREF
49|FROM VGFFIN FIN
50|  , TGFRAT RAT
51|WHERE
52|TRUNC(FIN.DTNEG) BETWEEN P_HOJE AND P_HOJE
53|AND FIN.RECDESP <> 0
54|AND NOT (FIN.PROVISAO = 'S' AND FIN.DHBAIXA IS NOT NULL AND FIN.ORIGEM='E')
55|AND (RAT.ORIGEM = 'F' AND FIN.NUFIN = RAT.NUFIN)
56|/*NATUREZA ESPECIAL*/
57|/*ANTECIPACAO*/ 
58|UNION ALL
59|
60|SELECT
61|  RAT.CODNAT AS CODNAT,
62|  RAT.CODCENCUS AS CODCENCUS,
63|  RAT.CODPROJ AS CODPROJ,
64|  FIN.NUFIN,
65|  FIN.DTNEG,
66|  FIN.DTVENC AS DTVENC,
67|  /* TEMRATADVALOR CASE WHEN FIN.VLRDESDOB = 0 THEN NVL(RAT.AD_VALOR,0) ELSE TEMRATADVALOR */ (FIN.VLRDESDOB * RAT.PERCRATEIO / 100) /* TEMRATADVALOR END TEMRATADVALOR */ * FIN.RECDESP AS VLRDESDOB,
68|  /* TEMRATADVALOR CASE WHEN FIN.VLRLIQUIDO = 0 THEN NVL(RAT.AD_VALOR,0) ELSE TEMRATADVALOR */ (FIN.VLRLIQUIDO * RAT.PERCRATEIO / 100) /* TEMRATADVALOR END TEMRATADVALOR */ * FIN.RECDESP AS VLRLIQUIDO,
69|  FIN.DTNEG AS DTREF
70|FROM VGFFIN FIN
71|  , TGFRAT RAT
72|WHERE
73|TRUNC(FIN.DTNEG) BETWEEN P_HOJE AND P_HOJE
74|AND FIN.RECDESP <> 0
