76|AND (RAT.ORIGEM = 'E' AND FIN.NUNOTA = RAT.NUFIN)
77|AND NOT EXISTS (SELECT 1 FROM TGFRAT RF WHERE RF.ORIGEM = 'F' AND RF.NUFIN = FIN.NUFIN)
78|/*NATUREZA ESPECIAL*/
