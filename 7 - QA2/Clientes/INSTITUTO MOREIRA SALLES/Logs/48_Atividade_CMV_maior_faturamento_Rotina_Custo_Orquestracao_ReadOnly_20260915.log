1|PROCEDURE STP_CALCULARCUSTOPRODUCAOMEDIO( RECCUSTO VARIAVEIS_PKG.TYPERECCUSTO ) AS
2|   --CALCULA CUSTOS DO DIA E CUSTO MEDIO ( TGFCUS )
3|   P_COUNT   INTEGER;
4|BEGIN
5|   /* VERIFICANDO SE HA CUSTO DIGITADO */
6|   SELECT COUNT( 1 )
7|     INTO P_COUNT
8|     FROM TGFCUS
9|    WHERE DTATUAL = RECCUSTO.DTBASE
10|      AND CODPROD = RECCUSTO.CODPROD
11|      AND CODEMP = RECCUSTO.CODEMP
12|      AND CODLOCAL = RECCUSTO.CODLOCAL
13|      AND CONTROLE = RECCUSTO.CONTROLE;
14|
15|   /* SE N?O HA CUSTO DIGITADO, ATUALIZA O CUSTO DO PA ( TGFCUS ) */
16|   IF P_COUNT = 0 THEN
17|      INSERT INTO TGFCUS
18|                  ( DTATUAL, CODPROD, CODEMP, CODLOCAL, CONTROLE, QTDNEG, QTDNEGGER, CUSGER, CUSVARIAVEL, CUSREP, ENTRADACOMICMS
19|                   ,ENTRADASEMICMS, TOTALCOMICMS, TOTALSEMICMS, AUTOMATICO, RECARGA )
20|         SELECT   DTATUAL
21|                 ,CODPROD
22|                 ,CODEMP
23|                 ,CODLOCAL
24|                 ,CONTROLE
25|                 ,SUM( QTDNEG ) AS QTDNEG
26|                 ,SUM( QTDNEG ) AS QTDNEGGER
27|                 ,ROUND( SUM( CUSGER * CASE
28|                                 WHEN QTDNEG = 0 THEN 1
29|                                 ELSE QTDNEG
30|                              END ) / CASE
31|                            WHEN SUM( QTDNEG ) = 0 THEN 1
32|                            ELSE SUM( QTDNEG )
33|                         END
34|                        ,VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS CUSGER
35|                 ,ROUND( SUM( CUSVARIAVEL * CASE
36|                                 WHEN QTDNEG = 0 THEN 1
37|                                 ELSE QTDNEG
38|                              END ) / CASE
39|                            WHEN SUM( QTDNEG ) = 0 THEN 1
40|                            ELSE SUM( QTDNEG )
41|                         END
42|                        ,VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS CUSVARIAVEL
43|                 ,ROUND( SUM( CUSREP * CASE
44|                                 WHEN QTDNEG = 0 THEN 1
45|                                 ELSE QTDNEG
46|                              END ) / CASE
47|                            WHEN SUM( QTDNEG ) = 0 THEN 1
48|                            ELSE SUM( QTDNEG )
49|                         END
50|                        ,VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS CUSREP
51|                 ,ROUND( SUM( ENTRADACOMICMS * CASE
52|                                 WHEN QTDNEG = 0 THEN 1
53|                                 ELSE QTDNEG
54|                              END ) / CASE
55|                            WHEN SUM( QTDNEG ) = 0 THEN 1
56|                            ELSE SUM( QTDNEG )
57|                         END
58|                        ,VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS ENTRADACOMICMS
59|                 ,ROUND( SUM( ENTRADASEMICMS * CASE
60|                                 WHEN QTDNEG = 0 THEN 1
61|                                 ELSE QTDNEG
62|                              END ) / CASE
63|                            WHEN SUM( QTDNEG ) = 0 THEN 1
64|                            ELSE SUM( QTDNEG )
65|                         END
66|                        ,VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS ENTRADASEMICMS
67|                 ,ROUND( SUM( ENTRADACOMICMS * CASE
68|                                 WHEN QTDNEG = 0 THEN 1
69|                                 ELSE QTDNEG
70|                              END ), VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS TOTALCOMICMS
71|                 ,ROUND( SUM( ENTRADASEMICMS * CASE
72|                                 WHEN QTDNEG = 0 THEN 1
73|                                 ELSE QTDNEG
74|                              END ), VARIAVEIS_PKG.V_DECIMAISPARACUSTO ) AS TOTALSEMICMS
75|                 ,'P' AS AUTOMATICO
76|                 ,'N' AS RECARGA
77|             FROM TGFCUSITE
78|            WHERE DTATUAL = RECCUSTO.DTBASE
79|              AND CODEMP = RECCUSTO.CODEMP
80|              AND CODPROD = RECCUSTO.CODPROD
81|              AND CODLOCAL = RECCUSTO.CODLOCAL
82|              AND CONTROLE = RECCUSTO.CONTROLE
83|         GROUP BY DTATUAL
84|                 ,CODPROD
85|                 ,CODEMP
86|                 ,CODLOCAL
87|                 ,CONTROLE;
88|
89|      STP_CALCULARCUSTOMEDIODIA( RECCUSTO.DTBASE, RECCUSTO.CODEMP, RECCUSTO.CODPROD, RECCUSTO.CODLOCAL, RECCUSTO.CONTROLE );
90|   END IF;
91|END;
