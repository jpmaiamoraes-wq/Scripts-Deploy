SQL> SELECT OWNER, NAME, TYPE, MIN(LINE) AS PRIMEIRA_LINHA, MAX(LINE) AS ULTIMA_LINHA, COUNT(*) AS OCORRENCIAS FROM ALL_SOURCE WHERE OWNER='SANKHYA' AND (UPPER(TEXT) LIKE '%TGFMGC_TMP%' OR UPPER(TEXT) LIKE '%STP_EFETIVA_CONSOLIDACAO_GOL%' OR UPPER(TEXT) LIKE '%TGFMGC%') GROUP BY OWNER, NAME, TYPE ORDER BY NAME, TYPE;

