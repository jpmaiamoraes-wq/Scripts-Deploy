----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
498|                                                          THEN
499|                                                             ITE.CONTROLE
500|                                                          ELSE
501|                                                             P_CONTROLE
502|                                                       END
503|                                                AND ( (   EXISTS
504|                                                             (SELECT 1
505|                                                                FROM TGFVAR V,
506|                                                                     TGFCAB VEN
507|                                                               WHERE     V.NUNOTA =
508|                                                                            CAB.NUNOTA
509|                                                                     AND V.SEQUENCIA =
510|                                                                            ITE.SEQUENCIA
511|                                                                     AND V.NUNOTA <>
512|                                                                            V.NUNOTAORIG
513|                                                                     AND V.NUNOTAORIG =
514|                                                                            VEN.NUNOTA
515|                                                                     AND VEN.DTENTSAI =
516|                                                                            P_DTBASE
517|                                                                     AND VEN.TIPMOV =
518|                                                                            'V'
519|                                                                     AND VEN.STATUSNOTA =
520|                                                                            'L')
521|                                                       OR NOT EXISTS
522|                                                                 (SELECT 1
523|                                                                    FROM TGFCUSITE CI
524|                                                                   WHERE     CI.NUNOTA =
525|                                                                                CAB.NUNOTA
526|                                                                         AND CI.SEQUENCIA =
527|                                                                                ITE.SEQUENCIA)))
528|                                            ) AS SOMA
529|                                           FROM TGFCAB CAB
530|                                           , TGFTOP TPO
531|                                          WHERE     CAB.STATUSNOTA = 'L'
532|                                                AND CAB.TIPMOV = 'D'
533|                                                AND CAB.DTENTSAI = P_DTBASE
534|                                                AND TPO.CODTIPOPER = CAB.CODTIPOPER
535|                                                AND TPO.DHALTER = CAB.DHTIPOPER
536|                                                AND TPO.PRECIFICA <> 'N'
537|                                         ) X
538|                                         )
539|                                         AS ENTRADAS1/*SA¿DAS DE REPROCESSO DE PRODU¿¿O */
540|                                      ,
541|                                      (SELECT NVL (SUM (tn.qtdreprocesso), 0)
542|                                                 AS QTDREPROCESSO
543|                                         FROM T_PRODUCOES_NIVEL TN
544|                                        WHERE     TN.CODPA = P_CODPROD
545|                                              AND TN.CODMP = P_CODPROD
546|                                              AND TN.CODEMP =
547|                                                     CASE
548|                                                        WHEN VARIAVEIS_PKG.V_CUSTOPOREMPRESA =
549|                                                                'N'
550|                                                        THEN
551|                                                           TN.CODEMP
552|                                                        ELSE
553|                                                           P_CODEMP
554|                                                     END
555|                                              AND TN.LOCMP =
556|                                                     CASE
557|                                                        WHEN VARIAVEIS_PKG.V_CUSTOPORLOCAL =
558|                                                                'N'
559|                                                        THEN
560|                                                           TN.LOCMP
561|                                                        ELSE
562|                                                           P_CODLOCAL
563|                                                     END
564|                                              AND TN.CONTMP =
565|                                                     CASE
566|                                                        WHEN VARIAVEIS_PKG.V_CUSTOPORCONTROLE =
567|                                                                'N'
568|                                                        THEN
569|                                                           TN.CONTMP
570|                                                        ELSE
571|                                                           P_CONTROLE
572|                                                     END)
573|                                         AS QTDREPROCESSO
574|                                 FROM    TGFCUS CUS
575|                                      LEFT JOIN
576|                                         TGFCUS CUSANT
577|                                      /* CUSTO ANTERIOR */
578|                                      ON (    CUSANT.CODPROD = P_CODPROD
579|                                          AND CUSANT.CODEMP = P_CODEMP
580|                                          AND CUSANT.CODLOCAL = P_CODLOCAL
581|                                          AND CUSANT.CONTROLE = P_CONTROLE
582|                                          AND CUSANT.DTATUAL <= P_DTBASE - 1
583|                                          /*CUSTO ANTERIOR*/
584|                                          AND CUSANT.DTATUAL = P_DTCUSTOANT/*CUSTO ANTERIOR*/
585|                                         )
586|                                WHERE     CUS.CODEMP = P_CODEMP
587|                                      AND CUS.CODPROD = P_CODPROD
588|                                      AND CUS.CODLOCAL = P_CODLOCAL
589|                                      AND CUS.CONTROLE = P_CONTROLE
590|                                      AND CUS.DTATUAL = P_DTBASE))) CUS_MED
591|           ON (    TGFCUS.DTATUAL = CUS_MED.DTATUAL
592|               AND TGFCUS.CODPROD = CUS_MED.CODPROD
593|               AND TGFCUS.CODEMP = CUS_MED.CODEMP
594|               AND TGFCUS.CODLOCAL = CUS_MED.CODLOCAL
595|               AND TGFCUS.CONTROLE = CUS_MED.CONTROLE)
596|   WHEN MATCHED
597|   THEN
598|      UPDATE SET
599|         TGFCUS.CUSMEDCALC = 'S',
600|         TGFCUS.CUSMEDICM =
601|            CASE WHEN ((CUS_MED.CUSMEDICM < 0) OR (RECARGA = 'S' AND (SELECT COUNT(1)
602|																	  FROM TGFCUS C                 
603|																	  WHERE C.CODPROD = P_CODPROD                 
604|																	    AND C.CODEMP = P_CODEMP                 
605|																	    AND C.CODLOCAL = P_CODLOCAL                 
606|																	    AND C.CONTROLE = P_CONTROLE) = 1)) THEN 0 ELSE CUS_MED.CUSMEDICM END,                 
607|         TGFCUS.CUSSEMICM =
608|            CASE WHEN ((CUS_MED.CUSSEMICM < 0) OR (RECARGA = 'S' AND (SELECT COUNT(1)
609|																	  FROM TGFCUS C                 
610|																	  WHERE C.CODPROD = P_CODPROD                 
611|																	    AND C.CODEMP = P_CODEMP                 
612|																	    AND C.CODLOCAL = P_CODLOCAL                 
613|																	    AND C.CONTROLE = P_CONTROLE) = 1)) THEN 0 ELSE CUS_MED.CUSSEMICM END,                 
614|         TGFCUS.CUSMED =
615|            CASE WHEN ((CUS_MED.CUSMED < 0) OR (RECARGA = 'S' AND (SELECT COUNT(1)
616|																	  FROM TGFCUS C                 
617|																	  WHERE C.CODPROD = P_CODPROD                 
618|																	    AND C.CODEMP = P_CODEMP                 
619|																	    AND C.CODLOCAL = P_CODLOCAL                 
620|																	    AND C.CONTROLE = P_CONTROLE) = 1)) THEN 0 ELSE CUS_MED.CUSMED END,                 
621|         TGFCUS.QTDNEG =
622|            CASE WHEN CUS_MED.QTDNEG < 0 THEN 0 ELSE CUS_MED.QTDNEG END,
623|         TGFCUS.QTDNEGGER =
624|            CASE WHEN CUS_MED.QTDNEGGER < 0 THEN 0 ELSE CUS_MED.QTDNEGGER END,
625|         TGFCUS.CUSGER =
626|            CASE
627|               WHEN RECARGA = 'S' THEN CUS_MED.CUSGERANT
628|               ELSE TGFCUS.CUSGER
629|            END,
630|         TGFCUS.CUSVARIAVEL =
631|            CASE
632|               WHEN RECARGA = 'S' THEN CUS_MED.CUSVARIAVELANT
633|               ELSE TGFCUS.CUSVARIAVEL
634|            END,
635|         TGFCUS.CUSREP =
636|            CASE
637|               WHEN RECARGA = 'S' THEN CUS_MED.CUSREPANT
638|               ELSE TGFCUS.CUSREP
639|            END,
640|         TGFCUS.ENTRADACOMICMS =
641|            CASE
642|               WHEN RECARGA = 'S' THEN CUS_MED.ENTRADACOMICMSANT
643|               ELSE TGFCUS.ENTRADACOMICMS
644|            END,
645|         TGFCUS.ENTRADASEMICMS =
646|            CASE
647|               WHEN RECARGA = 'S' THEN CUS_MED.ENTRADASEMICMSANT
648|               ELSE TGFCUS.ENTRADASEMICMS
649|            END
650|   WHEN NOT MATCHED
651|   THEN
652|      INSERT     (CODPROD,
653|                  CODEMP,
654|                  DTATUAL,
655|                  CODLOCAL,
656|                  CONTROLE,
657|                  CUSMEDICM,
658|                  CUSSEMICM,
659|                  CUSMED,
660|                  QTDNEG)
661|          VALUES (CUS_MED.CODPROD,
662|                  CUS_MED.CODEMP,
663|                  CUS_MED.DTATUAL,
664|                  CUS_MED.CODLOCAL,
665|                  CUS_MED.CONTROLE,
666|                  CUS_MED.CUSMEDICM,
667|                  CUS_MED.CUSSEMICM,
668|                  CUS_MED.CUSMED,
669|                  CUS_MED.QTDNEG);
670|
671|   IF VARIAVEIS_PKG.V_TEMPRODUTOSEMFAMILIA = 'S'
672|   THEN
673|      STP_CALCULARCUSTOMEDIOFAMILIA (P_DTBASE,
674|                                     P_CODEMP,
