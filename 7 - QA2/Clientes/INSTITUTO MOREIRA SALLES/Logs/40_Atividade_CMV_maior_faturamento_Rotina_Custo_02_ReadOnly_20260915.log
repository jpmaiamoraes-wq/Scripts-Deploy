SQL> SELECT LINE||'|'||TEXT FROM ALL_SOURCE WHERE OWNER='SANKHYA' AND NAME='STP_CALCULARCUSTOPRODGENERICO' ORDER BY LINE;

LINE||'|'||TEXT
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
1|PROCEDURE STP_CALCULARCUSTOPRODGENERICO (
2|   P_DTBASE      DATE,
3|   P_CODEMP      INT,
4|   P_CODPROD     INT, -- PRODUTO GENERICO
5|   P_CODLOCAL    INT,
6|   P_CONTROLE    VARCHAR2)
7|AS
8|BEGIN
9|
10|    MERGE INTO TGFCUS
11|    USING (
12|            SELECT
13|                   P_DTBASE AS DTATUAL
14|                 , P_CODPROD AS CODPROD
15|                 , CODEMP
16|                 , CODLOCAL
17|                 , ' ' AS CONTROLE
18|                 , QTDNEG
19|                 , QTDNEGGER
20|                 , CUSGER
21|                 , CUSVARIAVEL
22|                 , CUSREP
23|                 , ENTRADACOMICMS
24|                 , ENTRADASEMICMS
25|                 , TOTALCOMICMS
26|                 , TOTALSEMICMS
27|                 , RECARGA
28|            FROM (
29|                   SELECT
30|                        CODEMP
31|                      , CODLOCAL
32|                      , SUM(CASE WHEN I.FAMILIA = 'S' THEN 0 ELSE I.QTDNEG END) AS QTDNEG
33|                      , SUM(I.QTDNEG) AS QTDNEGGER
34|                      , ROUND(SUM(I.CUSGER * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) / CASE WHEN SUM(I.QTDNEG) = 0 THEN 1 ELSE SUM(I.QTDNEG) END , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS CUSGER
35|                      , ROUND(SUM(I.CUSVARIAVEL * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) / CASE WHEN SUM(I.QTDNEG) = 0 THEN 1 ELSE SUM(I.QTDNEG) END , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS CUSVARIAVEL
36|                      , ROUND(SUM(I.CUSREP * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) / CASE WHEN SUM(I.QTDNEG) = 0 THEN 1 ELSE SUM(I.QTDNEG) END , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS CUSREP
37|                      , ROUND(SUM(I.ENTRADACOMICMS * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) / CASE WHEN SUM(I.QTDNEG) = 0 THEN 1 ELSE SUM(I.QTDNEG) END , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS ENTRADACOMICMS
38|                      , ROUND(SUM(I.ENTRADASEMICMS * I.SINAL * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) / CASE WHEN SUM(I.QTDNEG) = 0 THEN 1 ELSE SUM(I.QTDNEG) END , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS ENTRADASEMICMS
39|                      , ROUND(SUM(I.ENTRADACOMICMS * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS TOTALCOMICMS
40|                      , ROUND(SUM(I.ENTRADASEMICMS * CASE WHEN I.QTDNEG = 0 THEN 1 ELSE I.QTDNEG END) , VARIAVEIS_PKG.V_DECIMAISPARACUSTO) AS TOTALSEMICMS
41|                      , CASE WHEN SUM(CASE WHEN I.TIPONOTA IN ('B','Q') THEN 0 ELSE 1 END) = 0 OR SUM(I.QTDNEG) = 0 THEN 'S' ELSE 'N' END AS RECARGA
42|                   FROM 
43|                      TGFCUSITE I
44|                   WHERE
45|                      I.DTATUAL  =  P_DTBASE
46|                      AND I.CODEMP   = CASE WHEN VARIAVEIS_PKG.V_CUSTOPOREMPRESA = 'N' THEN I.CODEMP ELSE P_CODEMP END
47|                      AND I.CODLOCAL = CASE WHEN VARIAVEIS_PKG.V_CUSTOPORLOCAL = 'N' THEN I.CODLOCAL ELSE P_CODLOCAL END
48|                      --AND I.CONTROLE =
49|                      AND I.CODPROD IN (SELECT CODPRODESP FROM TGFGXE WHERE CODPROD = P_CODPROD)
50|                   GROUP BY
51|                      CODEMP,
52|                      CODLOCAL
53|                )
54|    ) CUS_ENT
55|    ON (
56|        TGFCUS.DTATUAL = CUS_ENT.DTATUAL
57|        AND TGFCUS.CODPROD = CUS_ENT.CODPROD
58|        AND TGFCUS.CODEMP = CUS_ENT.CODEMP
59|        AND TGFCUS.CODLOCAL = CUS_ENT.CODLOCAL
60|    )
61|    WHEN MATCHED   
62|    THEN
63|       UPDATE SET
64|          TGFCUS.QTDNEG          = CASE WHEN CUS_ENT.QTDNEG < 0 THEN 0 ELSE CUS_ENT.QTDNEG END,
65|          TGFCUS.QTDNEGGER       = CASE WHEN CUS_ENT.QTDNEGGER < 0 THEN 0 ELSE CUS_ENT.QTDNEGGER END,
66|          TGFCUS.CUSGER          = CASE WHEN CUS_ENT.CUSGER < 0 THEN 0 ELSE CUS_ENT.CUSGER END,
67|          TGFCUS.CUSVARIAVEL     = CASE WHEN CUS_ENT.CUSVARIAVEL < 0 THEN 0 ELSE CUS_ENT.CUSVARIAVEL END,
68|          TGFCUS.CUSREP          = CASE WHEN CUS_ENT.CUSREP < 0 THEN 0 ELSE CUS_ENT.CUSREP END,
69|          TGFCUS.ENTRADACOMICMS  = CASE WHEN CUS_ENT.ENTRADACOMICMS < 0 THEN 0 ELSE CUS_ENT.ENTRADACOMICMS END,
70|          TGFCUS.ENTRADASEMICMS  = CASE WHEN CUS_ENT.ENTRADASEMICMS < 0 THEN 0 ELSE CUS_ENT.ENTRADASEMICMS END,
71|          TGFCUS.TOTALCOMICMS    = CASE WHEN CUS_ENT.TOTALCOMICMS < 0 THEN 0 ELSE CUS_ENT.TOTALCOMICMS END,
72|          TGFCUS.TOTALSEMICMS    = CASE WHEN CUS_ENT.TOTALSEMICMS < 0 THEN 0 ELSE CUS_ENT.TOTALSEMICMS END
73|    WHEN NOT MATCHED
74|    THEN
75|       INSERT     (CODPROD,
76|                  CODEMP,
77|                  DTATUAL,
78|                  CODLOCAL,
79|                  CONTROLE,
80|                  QTDNEG,
81|                  QTDNEGGER,
82|                  CUSGER,
83|                  CUSVARIAVEL,
84|                  CUSREP,
85|                  ENTRADACOMICMS,
86|                  ENTRADASEMICMS,
87|                  TOTALCOMICMS,
88|                  TOTALSEMICMS,
89|                  RECARGA)
90|          VALUES (CUS_ENT.CODPROD,
91|                  CUS_ENT.CODEMP,
92|                  CUS_ENT.DTATUAL,
93|                  CUS_ENT.CODLOCAL,
94|                  CUS_ENT.CONTROLE,
95|                  CUS_ENT.QTDNEG,
96|                  CUS_ENT.QTDNEGGER,
97|                  CUS_ENT.CUSGER,
98|                  CUS_ENT.CUSVARIAVEL,
99|                  CUS_ENT.CUSREP,
100|                  CUS_ENT.ENTRADACOMICMS,
101|                  CUS_ENT.ENTRADASEMICMS,
102|                  CUS_ENT.TOTALCOMICMS,
103|                  CUS_ENT.TOTALSEMICMS,
104|                  CUS_ENT.RECARGA);
105|    
106|END;

