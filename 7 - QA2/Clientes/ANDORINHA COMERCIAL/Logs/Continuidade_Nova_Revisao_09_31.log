SQL> -- Bloco 09_Habilitar_ICMS_Gerencial; backup por execucao e atualizacao apenas de divergencias.
SQL> SET DEFINE OFF
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> DECLARE v NUMBER; BEGIN
  2   SELECT COUNT(*) INTO v FROM ALL_TABLES WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA') AND TABLE_NAME='BKP_RMD_09_TGFPRO';
  3   IF v=0 THEN EXECUTE IMMEDIATE q'[CREATE TABLE BKP_RMD_09_TGFPRO AS
  4   SELECT CAST(NULL AS VARCHAR2(30)) ID_EXECUCAO, CAST(NULL AS TIMESTAMP) DH_EXECUCAO,
  5   CAST(NULL AS VARCHAR2(128)) USUARIO_EXECUCAO, CAST(NULL AS VARCHAR2(30)) ROWID_ORIGINAL,
  6   T.ICMSGERENCIA VALOR_ANTES, CAST('S' AS VARCHAR2(1)) VALOR_DEPOIS FROM TGFPRO T WHERE 1=0]'; END IF;
  7  END;
  8  /

PL/SQL procedure successfully completed.

SQL> DECLARE
  2   v_id VARCHAR2(30):='RMD_ICMG_'||TO_CHAR(SYSTIMESTAMP,'YYYYMMDDHH24MISSFF3');
  3   v_b PLS_INTEGER; v_u PLS_INTEGER;
  4  BEGIN
  5   INSERT INTO BKP_RMD_09_TGFPRO
  6   SELECT v_id,SYSTIMESTAMP,SYS_CONTEXT('USERENV','SESSION_USER'),ROWIDTOCHAR(ROWID),ICMSGERENCIA,CAST('S' AS VARCHAR2(1))
  7   FROM TGFPRO WHERE USOPROD IN ('V','R') AND NVL(ICMSGERENCIA,'?')<>'S';
  8   v_b:=SQL%ROWCOUNT;
  9   UPDATE TGFPRO SET ICMSGERENCIA='S' WHERE USOPROD IN ('V','R') AND NVL(ICMSGERENCIA,'?')<>'S';
 10   v_u:=SQL%ROWCOUNT;
 11   IF v_b<>v_u THEN RAISE_APPLICATION_ERROR(-20201,'Backup e atualizacao divergiram em 09_Habilitar_ICMS_Gerencial.'); END IF;
 12   COMMIT;
 13   DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||v_id);
 14   DBMS_OUTPUT.PUT_LINE('REGISTROS_ALTERADOS='||v_u);
 15  EXCEPTION WHEN OTHERS THEN ROLLBACK; RAISE;
 16  END;
 17  /
