 25          'AAAAAEEEEIIIIOOOOOUUUUCAAAAAEEEEIIIIOOOOOUUUUCAAAOOAAEIIOOUU')),' {2,}',' ') NORM
 26      FROM BKP_RMD_PAD_TSIEND WHERE ID_EXECUCAO=v_id
