=== DUPLICIDADES DE CHAVE ===
SQL> SELECT CHAVE, CODUSU, TIPO, NVL(CHAVEPAI,'<NULL>') CHAVEPAI, COUNT(*) QTD
  2  FROM BKP_RMD_TSICFG_ATUAL
  3  GROUP BY CHAVE, CODUSU, TIPO, NVL(CHAVEPAI,'<NULL>')
  4  HAVING COUNT(*) > 1
  5  ORDER BY QTD DESC, CHAVE;
