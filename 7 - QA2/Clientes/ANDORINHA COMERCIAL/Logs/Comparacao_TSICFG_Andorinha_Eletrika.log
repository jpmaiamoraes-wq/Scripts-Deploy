SQL> PROMPT === SOMENTE NA ANDORINHA ORIGINAL ===
=== SOMENTE NA ANDORINHA ORIGINAL ===
SQL> SELECT B.CHAVE, B.CODUSU, B.TIPO, B.CHAVEPAI
  2  FROM BKP_RMD_TSICFG_ATUAL B
  3  WHERE NOT EXISTS (
  4    SELECT 1 FROM TSICFG E
  5    WHERE E.CHAVE=B.CHAVE AND E.CODUSU=B.CODUSU AND E.TIPO=B.TIPO
  6      AND NVL(E.CHAVEPAI,CHR(0))=NVL(B.CHAVEPAI,CHR(0))
  7  )
  8  ORDER BY B.CHAVE;
no rows selected
SQL> 
SQL> PROMPT === SOMENTE NA ELETRIKA ===
=== SOMENTE NA ELETRIKA ===
SQL> SELECT E.CHAVE, E.CODUSU, E.TIPO, E.CHAVEPAI
  2  FROM TSICFG E
  3  WHERE NOT EXISTS (
  4    SELECT 1 FROM BKP_RMD_TSICFG_ATUAL B
  5    WHERE B.CHAVE=E.CHAVE AND B.CODUSU=E.CODUSU AND B.TIPO=E.TIPO
  6      AND NVL(B.CHAVEPAI,CHR(0))=NVL(E.CHAVEPAI,CHR(0))
  7  )
  8  ORDER BY E.CHAVE;
no rows selected
