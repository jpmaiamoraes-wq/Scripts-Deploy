SQL> PROMPT === MESMA CHAVE, CONFIGURACAO DIFERENTE ===
=== MESMA CHAVE, CONFIGURACAO DIFERENTE ===
SQL> SELECT B.CHAVE, B.CODUSU, B.TIPO, B.CHAVEPAI,
  2         DBMS_LOB.GETLENGTH(B.CONFIG) CONFIG_ORIGINAL,
  3         DBMS_LOB.GETLENGTH(E.CONFIG) CONFIG_ELETRIKA
  4  FROM BKP_RMD_TSICFG_ATUAL B
  5  JOIN TSICFG E
  6    ON E.CHAVE=B.CHAVE AND E.CODUSU=B.CODUSU AND E.TIPO=B.TIPO
  7   AND NVL(E.CHAVEPAI,CHR(0))=NVL(B.CHAVEPAI,CHR(0))
  8  WHERE (B.CONFIG IS NULL AND E.CONFIG IS NOT NULL)
  9     OR (B.CONFIG IS NOT NULL AND E.CONFIG IS NULL)
 10     OR (B.CONFIG IS NOT NULL AND E.CONFIG IS NOT NULL
 11         AND DBMS_LOB.COMPARE(B.CONFIG,E.CONFIG)<>0)
 12  ORDER BY B.CHAVE;
no rows selected
