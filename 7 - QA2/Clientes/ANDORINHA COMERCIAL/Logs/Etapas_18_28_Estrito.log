SQL> @@"/Users/spadarojr/Documents/Trabalho/Sankhya/Deploy Agent/Scripts-Deploy/7 - QA2/Revisao Master Deploy/23_Validar_Reabilitar_Objetos.sql"
SQL> -- Ultima barreira: reabilita somente objetos que estavam ENABLED quando uma
SQL> -- rotina desta revisao decidiu desabilita-los temporariamente.
SQL> SET DEFINE OFF
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> DECLARE
  2   v_status VARCHAR2(30);
  3   v_pendentes PLS_INTEGER:=0;
  4  BEGIN
  5   FOR R IN (
  6    SELECT DISTINCT ID_MASTER,ID_EXECUCAO,OBJECT_TYPE,OBJECT_NAME
  7      FROM RMD_CONTROLE_OBJETOS
  8     WHERE STATUS_ANTES='ENABLED'
  9       AND NVL(STATUS_DEPOIS,'PENDENTE')<>'ENABLED'
 10   ) LOOP
 11    IF R.OBJECT_TYPE='TRIGGER' THEN
 12     SELECT STATUS INTO v_status FROM ALL_TRIGGERS
 13      WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
 14        AND TRIGGER_NAME=R.OBJECT_NAME;
 15     IF v_status<>'ENABLED' THEN
 16      EXECUTE IMMEDIATE 'ALTER TRIGGER '||DBMS_ASSERT.ENQUOTE_NAME(R.OBJECT_NAME,FALSE)||' ENABLE';
 17     END IF;
 18     SELECT STATUS INTO v_status FROM ALL_TRIGGERS
 19      WHERE OWNER=SYS_CONTEXT('USERENV','CURRENT_SCHEMA')
 20        AND TRIGGER_NAME=R.OBJECT_NAME;
 21     UPDATE RMD_CONTROLE_OBJETOS
 22        SET STATUS_DEPOIS=v_status,DH_REABILITACAO=SYSTIMESTAMP
 23      WHERE ID_MASTER=R.ID_MASTER
 24        AND ID_EXECUCAO=R.ID_EXECUCAO
 25        AND OBJECT_TYPE=R.OBJECT_TYPE AND OBJECT_NAME=R.OBJECT_NAME
 26        AND STATUS_ANTES='ENABLED';
 27     IF v_status<>'ENABLED' THEN
 28      v_pendentes:=v_pendentes+1;
 29      DBMS_OUTPUT.PUT_LINE('OBJETO_NAO_REABILITADO='||R.OBJECT_TYPE||':'||R.OBJECT_NAME);
 30     ELSE
 31      DBMS_OUTPUT.PUT_LINE('OBJETO_REABILITADO='||R.OBJECT_TYPE||':'||R.OBJECT_NAME);
 32     END IF;
 33    ELSE
 34     v_pendentes:=v_pendentes+1;
 35     DBMS_OUTPUT.PUT_LINE('TIPO_SEM_ROTINA_DE_REABILITACAO='||R.OBJECT_TYPE||':'||R.OBJECT_NAME);
 36    END IF;
 37   END LOOP;
 38   COMMIT;
 39   IF v_pendentes>0 THEN
 40    RAISE_APPLICATION_ERROR(-20500,'Existem objetos da revisao que nao foram reabilitados: '||v_pendentes);
 41   END IF;
 42   DBMS_OUTPUT.PUT_LINE('OBJETOS_DA_REVISAO_PENDENTES=0');
 43  END;
 44  /
OBJETOS_DA_REVISAO_PENDENTES=0


