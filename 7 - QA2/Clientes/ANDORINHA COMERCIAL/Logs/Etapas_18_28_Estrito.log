SQL> DECLARE
  2    c_id_execucao CONSTANT VARCHAR2(30) :=
  3      'AJNP_' || TO_CHAR(SYSTIMESTAMP, 'YYYYMMDDHH24MISSFF3');
  4  
  5    v_alterados     PLS_INTEGER := 0;
  6    v_backups       PLS_INTEGER := 0;
  7  
  8    FUNCTION somente_digitos(p_texto VARCHAR2) RETURN VARCHAR2 IS
  9    BEGIN
 10      RETURN REGEXP_REPLACE(p_texto, '[^0-9]', '');
 11    END;
 12  
 13    FUNCTION textos_diferentes(p_atual VARCHAR2, p_novo VARCHAR2) RETURN BOOLEAN IS
 14    BEGIN
 15      RETURN (p_atual <> p_novo)
 16          OR (p_atual IS NULL AND p_novo IS NOT NULL)
 17          OR (p_atual IS NOT NULL AND p_novo IS NULL);
 18    END;
 19  
 20    FUNCTION nome_ajustado(
 21      p_nome    VARCHAR2,
 22      p_cgc_cpf VARCHAR2
 23    ) RETURN VARCHAR2 IS
 24      v_nome          VARCHAR2(4000);
 25      v_documento     VARCHAR2(32);
 26      v_bloco_inicial VARCHAR2(4000);
 27      v_bloco_final   VARCHAR2(4000);
 28      v_digitos       VARCHAR2(64);
 29      v_resultado     VARCHAR2(4000);
 30      v_removeu       BOOLEAN := FALSE;
 31  
 32      FUNCTION corresponde_documento(p_digitos VARCHAR2) RETURN BOOLEAN IS
 33      BEGIN
 34        RETURN LENGTH(p_digitos) >= 6
 35           AND INSTR(v_documento, p_digitos) > 0;
 36      END;
 37    BEGIN
 38      IF p_nome IS NULL OR p_cgc_cpf IS NULL THEN
 39        RETURN p_nome;
 40      END IF;
 41  
 42      v_nome := REPLACE(REPLACE(REPLACE(p_nome, CHR(160), ' '), CHR(9), ' '), CHR(13), ' ');
 43      v_nome := REPLACE(v_nome, CHR(10), ' ');
 44      v_documento := somente_digitos(p_cgc_cpf);
 45  
 46      v_resultado := v_nome;
 47  
 48      -- Captura o bloco anterior a primeira letra.
 49      v_bloco_inicial := REGEXP_SUBSTR(v_nome, '^[0-9 .,/()-]*');
 50      v_digitos := somente_digitos(v_bloco_inicial);
 51  
 52      IF corresponde_documento(v_digitos) THEN
 53        v_resultado := SUBSTR(v_resultado, LENGTH(v_bloco_inicial) + 1);
 54        v_removeu := TRUE;
 55      END IF;
 56  
 57      -- Captura o bloco posterior a ultima letra, depois do ajuste inicial.
 58      v_bloco_final := REGEXP_SUBSTR(v_resultado, '[0-9 .,/()-]*$');
 59      v_digitos := somente_digitos(v_bloco_final);
 60  
 61      IF corresponde_documento(v_digitos) THEN
 62        v_resultado := SUBSTR(v_resultado, 1, LENGTH(v_resultado) - LENGTH(v_bloco_final));
 63        v_removeu := TRUE;
 64      END IF;
 65  
 66      IF NOT v_removeu THEN
 67        RETURN p_nome;
 68      END IF;
 69  
 70      v_resultado := REGEXP_REPLACE(TRIM(v_resultado), ' +', ' ');
 71  
 72      IF v_resultado IS NULL OR NOT REGEXP_LIKE(v_resultado, '[A-Za-z]') THEN
 73        RETURN p_nome;
 74      END IF;
 75  
 76      RETURN v_resultado;
 77    END;
 78  BEGIN
 79    SAVEPOINT AJUSTE_NOMES_INICIO;
 80  
 81    FOR r IN (
 82      SELECT CODPARC, NOMEPARC, RAZAOSOCIAL, CGC_CPF
 83        FROM TGFPAR
 84       WHERE CGC_CPF IS NOT NULL
 85         AND (NOMEPARC IS NOT NULL OR RAZAOSOCIAL IS NOT NULL)
 86       ORDER BY CODPARC
 87    ) LOOP
 88      DECLARE
 89        v_nome_novo  TGFPAR.NOMEPARC%TYPE;
 90        v_razao_nova TGFPAR.RAZAOSOCIAL%TYPE;
 91      BEGIN
 92        v_nome_novo  := nome_ajustado(r.NOMEPARC, r.CGC_CPF);
 93        v_razao_nova := nome_ajustado(r.RAZAOSOCIAL, r.CGC_CPF);
 94  
 95        IF textos_diferentes(r.NOMEPARC, v_nome_novo)
 96           OR textos_diferentes(r.RAZAOSOCIAL, v_razao_nova)
 97        THEN
 98          INSERT INTO BKP_AJNP_TGFPAR (
 99            ID_EXECUCAO, DH_EXECUCAO, USUARIO_EXECUCAO, CODPARC,
100            NOMEPARC_ANTES, RAZAOSOCIAL_ANTES,
101            NOMEPARC_DEPOIS, RAZAOSOCIAL_DEPOIS
102          ) VALUES (
103            c_id_execucao, SYSDATE, SYS_CONTEXT('USERENV', 'SESSION_USER'), r.CODPARC,
104            r.NOMEPARC, r.RAZAOSOCIAL, v_nome_novo, v_razao_nova
105          );
106          v_backups := v_backups + 1;
107  
108          UPDATE TGFPAR
109             SET NOMEPARC    = v_nome_novo,
110                 RAZAOSOCIAL = v_razao_nova
111           WHERE CODPARC = r.CODPARC;
112          v_alterados := v_alterados + SQL%ROWCOUNT;
113        END IF;
114      END;
115    END LOOP;
116  
117    IF v_alterados <> v_backups THEN
118      RAISE_APPLICATION_ERROR(
119        -20031,
120        'Quantidade alterada (' || v_alterados ||
121        ') difere dos backups (' || v_backups || ').'
122      );
123    END IF;
124  
125    COMMIT;
126  
127    DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO=' || c_id_execucao);
128    DBMS_OUTPUT.PUT_LINE('BACKUPS=' || v_backups);
129    DBMS_OUTPUT.PUT_LINE('REGISTROS_ALTERADOS=' || v_alterados);
130  EXCEPTION
131    WHEN OTHERS THEN
132      ROLLBACK TO AJUSTE_NOMES_INICIO;
133      DBMS_OUTPUT.PUT_LINE('ERRO: ' || SQLERRM);
134      RAISE;
135  END;
136  /
ID_EXECUCAO=AJNP_20260908145621677
BACKUPS=10
REGISTROS_ALTERADOS=10


PL/SQL procedure successfully completed.

