SQL> @@"/Users/spadarojr/Documents/Trabalho/Sankhya/Deploy Agent/Scripts-Deploy/7 - QA2/Revisao Master Deploy/22_Ajustar_Nomes_Parceiros.sql"
SQL> -- ============================================================
SQL> -- Ajuste_nomes_parceros_numeros.sql
SQL> -- Remove do INICIO ou do FIM de NOMEPARC/RAZAOSOCIAL um trecho
SQL> -- numerico que faca parte do CPF/CNPJ do proprio parceiro.
SQL> --
SQL> -- Seguranca:
SQL> --   * exige ao menos 6 digitos coincidentes;
SQL> --   * preserva numeros no meio do nome;
SQL> --   * nao permite que o nome fique sem letras;
SQL> --   * altera somente registros efetivamente divergentes;
SQL> --   * cria backup persistente, auditavel por ID_EXECUCAO;
SQL> --   * pode ser executado novamente sem repetir alteracoes.
SQL> -- ============================================================
SQL> 
SQL> SET DEFINE OFF
SQL> SET SERVEROUTPUT ON SIZE UNLIMITED
SQL> SET SQLBLANKLINES ON
SQL> WHENEVER SQLERROR EXIT SQL.SQLCODE ROLLBACK
SQL> 
SQL> -- A estrutura precisa existir antes da compilacao do bloco que faz o INSERT.
SQL> DECLARE
  2    v_tabela_existe NUMBER;
  3  BEGIN
  4    SELECT COUNT(*)
  5      INTO v_tabela_existe
  6      FROM ALL_TABLES
  7     WHERE OWNER = SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
  8       AND TABLE_NAME = 'BKP_AJNP_TGFPAR';
  9  
 10    IF v_tabela_existe = 0 THEN
 11      EXECUTE IMMEDIATE q'[
 12        CREATE TABLE BKP_AJNP_TGFPAR AS
 13        SELECT CAST(NULL AS VARCHAR2(30))  AS ID_EXECUCAO,
 14               CAST(NULL AS DATE)          AS DH_EXECUCAO,
 15               CAST(NULL AS VARCHAR2(128)) AS USUARIO_EXECUCAO,
 16               P.CODPARC,
 17               P.NOMEPARC    AS NOMEPARC_ANTES,
 18               P.RAZAOSOCIAL AS RAZAOSOCIAL_ANTES,
 19               P.NOMEPARC    AS NOMEPARC_DEPOIS,
 20               P.RAZAOSOCIAL AS RAZAOSOCIAL_DEPOIS
 21          FROM TGFPAR P
 22         WHERE 1 = 0
 23      ]';
 24      DBMS_OUTPUT.PUT_LINE('BACKUP_CRIADO=BKP_AJNP_TGFPAR');
 25    ELSE
 26      DBMS_OUTPUT.PUT_LINE('BACKUP_EXISTENTE=BKP_AJNP_TGFPAR');
 27    END IF;
 28  END;
 29  /
BACKUP_EXISTENTE=BKP_AJNP_TGFPAR


