SQL> DECLARE
  2    v_id_execucao VARCHAR2(30) := 'CLASSICMS_' || TO_CHAR(SYSTIMESTAMP, 'YYYYMMDDHH24MISSFF3');
  3    v_backup       NUMBER;
  4    v_atualizados  NUMBER;
  5  BEGIN
  6    INSERT INTO BKP_CLASSICMS_TGFPAR
  7      (ID_EXECUCAO, DH_EXECUCAO, CODPARC, CLASSIFICMS_ANTES, CLASSIFICMS_DEPOIS)
  8    SELECT v_id_execucao,
  9           SYSTIMESTAMP,
 10           CODPARC,
 11           CLASSIFICMS,
 12           CASE
 13             WHEN TIPPESSOA = 'J'
 14              AND IDENTINSCESTAD IS NOT NULL
 15              AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO' THEN 'R'
 16             WHEN TIPPESSOA = 'F'
 17              AND IDENTINSCESTAD IS NOT NULL
 18              AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO' THEN 'P'
 19             WHEN NVL(UPPER(TRIM(IDENTINSCESTAD)), 'ISENTO') = 'ISENTO' THEN 'C'
 20           END
 21      FROM TGFPAR
 22     WHERE (TIPPESSOA = 'J'
 23            AND IDENTINSCESTAD IS NOT NULL
 24            AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO'
 25            AND NVL(CLASSIFICMS, 'Z') <> 'R')
 26        OR (TIPPESSOA = 'F'
 27            AND IDENTINSCESTAD IS NOT NULL
 28            AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO'
 29            AND NVL(CLASSIFICMS, 'Z') <> 'P')
 30        OR (NVL(UPPER(TRIM(IDENTINSCESTAD)), 'ISENTO') = 'ISENTO'
 31            AND NVL(CLASSIFICMS, 'Z') <> 'C');
 32    v_backup := SQL%ROWCOUNT;
 33    UPDATE TGFPAR
 34       SET CLASSIFICMS = CASE
 35             WHEN TIPPESSOA = 'J'
 36              AND IDENTINSCESTAD IS NOT NULL
 37              AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO' THEN 'R'
 38             WHEN TIPPESSOA = 'F'
 39              AND IDENTINSCESTAD IS NOT NULL
 40              AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO' THEN 'P'
 41             WHEN NVL(UPPER(TRIM(IDENTINSCESTAD)), 'ISENTO') = 'ISENTO' THEN 'C'
 42           END
 43     WHERE (TIPPESSOA = 'J'
 44            AND IDENTINSCESTAD IS NOT NULL
 45            AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO'
 46            AND NVL(CLASSIFICMS, 'Z') <> 'R')
 47        OR (TIPPESSOA = 'F'
 48            AND IDENTINSCESTAD IS NOT NULL
 49            AND UPPER(TRIM(IDENTINSCESTAD)) <> 'ISENTO'
 50            AND NVL(CLASSIFICMS, 'Z') <> 'P')
 51        OR (NVL(UPPER(TRIM(IDENTINSCESTAD)), 'ISENTO') = 'ISENTO'
 52            AND NVL(CLASSIFICMS, 'Z') <> 'C');
 53    v_atualizados := SQL%ROWCOUNT;
 54    IF v_atualizados <> v_backup THEN
 55      RAISE_APPLICATION_ERROR(-20031,
 56        'Backup e atualizacao divergiram: backup=' || v_backup ||
 57        ', atualizados=' || v_atualizados);
 58    END IF;
 59    COMMIT;
 60    DBMS_OUTPUT.PUT_LINE('OK: Classificacao ICMS concluida. ID_EXECUCAO=' || v_id_execucao ||
 61                         ', parceiros=' || v_atualizados);
 62  EXCEPTION
 63    WHEN OTHERS THEN
 64      ROLLBACK;
 65      DBMS_OUTPUT.PUT_LINE('ERRO: Classificacao ICMS revertida. ' || SQLERRM);
 66      RAISE;
 67  END;
 68  /
