 27      T.FINANCEIROSRECEBER
 28  ) = (
 29  SELECT
 30   q_eventos.TOTAL as TOTAL,
 31   (q_eventos.ERRO + q_eventos.duplicada + q_eventos.cancelada) AS ERROS_TOTAL, 
 32   q_eventos.processado AS PROCESSANDO,
 33   q_eventos.totalNfe AS TOTAL_NFE,
 34   (q_eventos.erronfe + q_eventos.duplicada + q_eventos.cancelada) AS ERRO_NFE,
 35   q_eventos.processado AS FINALIZADO,
 36   (q_eventos.processado + q_eventos.erronfe + q_eventos.processando + q_eventos.duplicada + q_eventos.cancelada) AS BASICOS,
 37   q_config.EMPRESAS AS EMPRESAS,
 38   q_config.TIPOSDEOPERACAO,
 39   q_config.PARCEIROS,
 40   q_produtos.PRODUTOS,
 41   q_config.ENDERECOS,
 42   q_produtos.VOLUMES,
 43   q_notas.notasDevolucaoCompras,
 44   q_notas.notasDeCompras,
 45   q_notas.notasDevolucaoVendas,
 46   q_notas.notasDeVendas,
 47   q_financeiro.financeirosAPagar,
 48   q_financeiro.financeirosAReceber
 49  FROM
 50    (
 51      SELECT
 52        COUNT(CASE WHEN CAB.TIPMOV = 'C' THEN 1 END) AS notasDeCompras,
 53        COUNT(CASE WHEN CAB.TIPMOV = 'E' THEN 1 END) AS notasDevolucaoCompras,
 54        COUNT(CASE WHEN CAB.TIPMOV = 'V' THEN 1 END) AS notasDeVendas,
 55        COUNT(CASE WHEN CAB.TIPMOV = 'D' THEN 1 END) AS notasDevolucaoVendas
 56      FROM TGFCAB CAB
 57      INNER JOIN TTKNOT ON TTKNOT.NUNOTA = CAB.NUNOTA
 58    ) q_notas,
 59    (
 60      SELECT
 61        COUNT(CASE WHEN FIN.RECDESP = -1 THEN 1 END) AS financeirosAPagar,
 62        COUNT(CASE WHEN FIN.RECDESP = 1 THEN 1 END) AS financeirosAReceber
 63      FROM TGFFIN FIN
 64      INNER JOIN TTKNOT ON TTKNOT.NUNOTA = FIN.NUNOTA
 65    ) q_financeiro,
 66    (
 67      SELECT
 68        COUNT(DISTINCT P.CODPROD) AS produtos,
 69        COUNT(DISTINCT V.CODVOL) AS volumes
 70      FROM TGFPRO P
 71      INNER JOIN TGFVOL V ON P.CODVOL = V.CODVOL
 72    ) q_produtos,
 73    (
 74      SELECT
 75        (SELECT COUNT(1) FROM TSIEMP) AS empresas,
 76        (SELECT COUNT(1) FROM TGFPAR WHERE DTALTER >= sysdate-2) AS parceiros,
 77        (SELECT COUNT(1) FROM TSIEND WHERE DTALTER >= sysdate-2) AS enderecos,
 78        (SELECT COUNT(DISTINCT CODTIPOPER) FROM TGFTOP WHERE ATIVO = 'S' AND CODTIPOPER <> 0) AS tiposDeOperacao,
 79        (SELECT COUNT(1) FROM TGFTPV WHERE DHALTER >= sysdate-2) AS tiposDeNegociacao
 80      FROM DUAL
 81    ) q_config,
 82    (
 83      SELECT
 84        COUNT(*) AS total,
 85        count(CASE WHEN tipo <> 'OUTROS' THEN 1 END) AS totalNfe,
 86        count(CASE WHEN tipo <> 'OUTROS' and status = 'E'  THEN 1 END) AS erronfe,
 87        COUNT(CASE WHEN status = 'F' THEN 1 END) AS processado,
 88        COUNT(CASE WHEN status = 'N' THEN 1 END) AS processandoNota,
 89        COUNT(CASE WHEN status = 'X' THEN 1 END) AS processando,
 90        COUNT(CASE WHEN status = 'E' THEN 1 END) AS erro,
 91        COUNT(CASE WHEN status = 'D' THEN 1 END) AS duplicada,
 92        COUNT(CASE WHEN status = 'C' THEN 1 END) AS cancelada,
 93        COUNT(CASE WHEN status IS NULL THEN 1 END) AS pendente
 94      FROM TTKEVT EVT
 95    ) q_eventos
 96    ) WHERE T.SEQUENCIA = 1;
 97  
 98   v:=SQL%ROWCOUNT;
 99   IF v<>1 THEN RAISE_APPLICATION_ERROR(-20312,'Atualizacao dos cards nao alterou exatamente uma linha.');END IF;
100   COMMIT;
101   DBMS_OUTPUT.PUT_LINE('ID_EXECUCAO='||v_id);
102   DBMS_OUTPUT.PUT_LINE('CARDS_ATUALIZADOS='||v);
103  END;
104  /
ID_EXECUCAO=RMD_CARD_20260908145618798
CARDS_ATUALIZADOS=1


