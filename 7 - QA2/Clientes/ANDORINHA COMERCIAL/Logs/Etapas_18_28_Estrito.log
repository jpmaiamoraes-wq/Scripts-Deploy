  6     SYS_CONTEXT('USERENV','SESSION_USER'),T.* FROM TTKINDAGT T WHERE SEQUENCIA=1;
  7  UPDATE TTKINDAGT T
  8  SET (
  9       T.QTDARQUIVOS,
 10      T.QTDERRO,
 11      T.QTDSUCESSO,
 12      T.QTDARQUIVOSNFE,
 13      T.QTDERRONFE,
