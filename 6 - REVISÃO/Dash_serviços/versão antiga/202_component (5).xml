<gadget ><prompt-parameters><parameter  id="P_DATA_INI" description="Data Inicial" metadata="date" required="false" keep-last="true" keep-date="false" show-inactives="false" label="P_DATA_INI : Data" order="0"/><parameter  id="P_DATA_FIM" description="Data Final" metadata="date" required="false" keep-last="true" keep-date="false" show-inactives="false" label="P_DATA_FIM : Data" order="1"/><parameter  id="P_EMPRESA" description="EMPRESA" metadata="multiList:Text" listType="sql" required="false" keep-last="true" keep-date="false" show-inactives="false" label="P_EMPRESA : multiList:Text" order="2"><expression type="SQL"><![CDATA[
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        SELECT 
        EMP.CODEMP AS VALUE,
        EMP.CODEMP || ' - ' || EMP.RAZAOSOCIAL AS LABEL
        FROM TSIEMP EMP
        ORDER BY EMP.CODEMP
        
      
      
      
      
      
      
      
      
      
      
      
      
      
      ]]></expression></parameter><parameter  id="P_UF" description="ESTADO" metadata="multiList:Text" listType="sql" required="false" keep-last="false" keep-date="false" show-inactives="false" label="P_UF : multiList:Text" order="3"><expression type="SQL"><![CDATA[
        
        
        
        
        
        
        
        
        
        
        
        
        
        SELECT CODUF AS VALUE, UF || ' - ' || DESCRICAO AS LABEL
  FROM TSIUFS
  ORDER BY UF
      
      
      
      
      
      
      
      
      
      
      
      
      
      ]]></expression></parameter><parameter  id="P_TOP" description="TIPO DE OPERAÇÃO" metadata="multiList:Text" listType="sql" required="false" keep-last="false" keep-date="false" show-inactives="false" label="P_TOP : multiList:Text" order="4"><expression type="SQL"><![CDATA[
        
        
        
        
        
        
        
        
        
        
        
    SELECT 
        TOP.CODTIPOPER AS VALUE,
        TOP.CODTIPOPER || ' - ' || TOP.DESCROPER AS LABEL
    FROM TGFTOP TOP
    WHERE TOP.ATIVO = 'S'
      /* Garante que a TOP está configurada para serviços ou já foi usada em uma nota de serviço */
      AND EXISTS (
          SELECT 1 
          FROM TGFITE ITE 
          INNER JOIN TGFCAB CAB ON ITE.NUNOTA = CAB.NUNOTA 
          INNER JOIN TGFPRO PRO ON ITE.CODPROD = PRO.CODPROD
          WHERE CAB.CODTIPOPER = TOP.CODTIPOPER 
            AND PRO.USOPROD = 'S'
            AND CAB.DTNEG >= ADD_MONTHS(SYSDATE, -6) -- Otimização: olha apenas os últimos 6 meses
      )
    GROUP BY TOP.CODTIPOPER, TOP.DESCROPER
    ORDER BY TOP.CODTIPOPER
    
      
      
      
      
      
      
      
      
      
      
      ]]></expression></parameter></prompt-parameters><level id="lvl_serv_capa" description="Cockpit de Serviços"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_0DS" entryPoint="0_bi_servicos.jsp"></html5component></container></level><level id="lvl_tomadores" description="Maiores Tomadores"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_0G8" entryPoint="1_dashboard_maiores_tomadores.jsp"></html5component></container></level><level id="lvl_iss_municipio" description="ISS por Município"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_0PJ" entryPoint="2_dashboard_ISS_por_mun.jsp"></html5component></container></level><level id="lvl_conferencia_top" description="Conferência por Tipo de Operação"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_18I" entryPoint="3_dashboard_conferencia_top.jsp"></html5component></container></level><level id="lvl_servicos_utilizados" description="Dashboard - Ranking de Serviços"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_10M" entryPoint="4_dashboard_ranking_servicos.jsp"></html5component></container></level><level id="lvl_faturamento_mensal" description="Evolução de Faturamento"><container orientacao="H" tamanhoRelativo="100"><html5component id="html5_1EV" entryPoint="5_dashboard_faturamento_mensal.jsp"></html5component></container></level><level id="lvl_ticket_medio" description="Ticket Médio de Notas de Serviço"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_1CB" entryPoint="6_dashboard_ticket_medio.jsp"></html5component></container></level><level id="lvl_clientes_inativos" description="Clientes Inativos"><container orientacao="V" tamanhoRelativo="100"><html5component id="html5_1CC" entryPoint="7_dashboard_clientes_inativos.jsp"></html5component></container></level><level id="lvl_mapa_tributario" description="Mapa Tributário de Serviços"><args ><arg id="P_DATA_FIM" label="P_DATA